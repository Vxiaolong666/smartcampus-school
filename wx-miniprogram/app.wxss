/* ==================== 全局：AI 智能分析（与 uniapp App.vue 全局样式一致） ==================== */

/* 页内触发按钮（全站统一样式，与「成绩查询」页一致） */
.ai-analyze-wrap {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.ai-analyze-btn {
  background: linear-gradient(135deg, #13c2c2, #1890ff);
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(19, 194, 194, 0.3);
}

.ai-analyze-btn.ai-loading {
  opacity: 0.7;
}

/* 右侧浮动圆形触发按钮（各 AI 页面通用） */
.ai-fab {
  position: fixed;
  right: 28rpx;
  bottom: 160rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #13c2c2, #1890ff);
  box-shadow: 0 12rpx 30rpx rgba(19, 194, 194, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 90;
  animation: aiFabPulse 2.4s ease-out infinite;
}

/* tabBar 页面（如今日课程）需再抬高，避免被底部标签栏遮挡 */
.ai-fab--tab {
  bottom: 250rpx;
}

.ai-fab-icon {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1.05;
}

.ai-fab-label {
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1.05;
  opacity: 0.92;
}

.ai-fab:active {
  transform: scale(0.92);
}

.ai-fab.ai-loading {
  opacity: 0.75;
}

/* 呼吸光圈，提示「可点击生成 AI 分析」 */
@keyframes aiFabPulse {
	0% {
		box-shadow: 0 12rpx 30rpx rgba(19, 194, 194, 0.45), 0 0 0 0 rgba(19, 194, 194, 0.4);
	}
	70% {
		box-shadow: 0 12rpx 30rpx rgba(19, 194, 194, 0.45), 0 0 0 20rpx rgba(19, 194, 194, 0);
	}
	100% {
		box-shadow: 0 12rpx 30rpx rgba(19, 194, 194, 0.45), 0 0 0 0 rgba(19, 194, 194, 0);
	}
}

/* ==================== 协议中心 & 协议页（全站通用，类名统一 ag- 前缀） ==================== */
.ag-page {
	min-height: 100vh;
	background: #eff1ff;
}

/* 自定义导航栏标题：与其它页面保持一致（白字），避免协议页标题显示为黑色 */
.ag-page .nav-title {
	height: 100%;
	display: flex;
	align-items: center;
	font-size: 32rpx;
	font-weight: bold;
	position: relative;
	z-index: 1;
	color: #ffffff;
	letter-spacing: 6rpx;
}

.ag-bg-wrapper {
	position: fixed;
	width: 100%;
	top: 0;
}

.ag-bg {
	width: 100%;
	position: absolute;
	top: 0;
	height: 800rpx;
}

.ag-bg-mask {
	background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
	height: 600rpx;
	position: absolute;
	width: 100%;
	top: 0;
}

.ag-content {
	position: relative;
	z-index: 1;
	background: #eff1ff;
	top: 30rpx;
	min-height: calc(100vh - 200rpx);
	border-top-left-radius: 60rpx;
	border-top-right-radius: 60rpx;
	box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
	padding: 30rpx;
	padding-bottom: 40rpx;
}

/* 协议中心：顶部说明 */
.ag-intro {
	background: #ffffff;
	border-radius: 20rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
	box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, .05);
}

.ag-intro-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #48416f;
	margin-bottom: 12rpx;
}

.ag-intro-desc {
	font-size: 25rpx;
	color: #948eb3;
	line-height: 1.8;
}

/* 协议中心：列表 */
.ag-list-card {
	background: #ffffff;
	border-radius: 20rpx;
	overflow: hidden;
	box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, .05);
}

.ag-item {
	display: flex;
	align-items: center;
	padding: 32rpx 30rpx;
	border-bottom: 1rpx solid #f2f2f7;
}

.ag-item:last-child {
	border-bottom: none;
}

.ag-item:active {
	background: #fafaff;
}

.ag-item-icon {
	width: 56rpx;
	height: 56rpx;
	margin-right: 22rpx;
	flex-shrink: 0;
}

.ag-item-main {
	flex: 1;
	min-width: 0;
}

.ag-item-title {
	font-size: 30rpx;
	color: #48416f;
	font-weight: 500;
}

.ag-item-desc {
	font-size: 22rpx;
	color: #948eb3;
	margin-top: 8rpx;
	line-height: 1.6;
}

.ag-item-arrow {
	width: 28rpx;
	height: 28rpx;
	opacity: .5;
	margin-left: 16rpx;
	flex-shrink: 0;
}

/* 协议中心：底部提示 */
.ag-tips {
	margin-top: 26rpx;
	padding: 0 10rpx;
	font-size: 22rpx;
	color: #948eb3;
	line-height: 1.8;
	text-align: center;
}

/* 协议详情：卡片 */
.ag-card {
	background: #ffffff;
	border-radius: 20rpx;
	overflow: hidden;
	box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, .05);
}

.ag-header {
	display: flex;
	align-items: center;
	padding: 40rpx 30rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.ag-logo {
	width: 60rpx;
	height: 60rpx;
	margin-right: 20rpx;
}

.ag-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #48416f;
}

.ag-body {
	padding: 30rpx;
}

.ag-update {
	font-size: 22rpx;
	color: #948eb3;
	text-align: right;
	margin-bottom: 22rpx;
}

.ag-rich {
	display: block;
	font-size: 26rpx;
	color: #48416f;
	line-height: 1.8;
	word-break: break-word;
}

/* 协议正文图片：原生 image mode="widthFix" 渲染，宽度自适应、高度自动，各端稳定显示 */
.ag-rich-img {
	display: block;
	width: 100%;
	margin: 20rpx 0;
	border-radius: 12rpx;
}

/* 协议页底部操作：关于我们 / 联系客服（与隐私协议页样式一致） */
.ag-actions {
	display: flex;
	gap: 20rpx;
	margin-top: 30rpx;
}

.ag-action-btn {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 12rpx;
	height: 96rpx;
	padding: 0;
	margin: 0;
	background: #ffffff;
	border-radius: 16rpx;
	box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, .05);
	font-size: 28rpx;
	font-weight: 500;
	color: #48416f;
	line-height: normal;
}

.ag-action-btn::after {
	border: none;
}

.ag-action-icon {
	width: 36rpx;
	height: 36rpx;
}

.ag-action-text {
	font-size: 28rpx;
	color: #48416f;
}

.ag-loading {
	padding: 80rpx 0;
	text-align: center;
	font-size: 26rpx;
	color: #948eb3;
}

/* 协议未发布：兜底空状态 */
.ag-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 70rpx 30rpx 50rpx;
}

.ag-empty-icon {
	width: 140rpx;
	height: 140rpx;
	margin-bottom: 26rpx;
}

.ag-empty-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #48416f;
	margin-bottom: 14rpx;
}

.ag-empty-desc {
	font-size: 24rpx;
	color: #948eb3;
	line-height: 1.8;
	text-align: center;
}

.ag-footer {
	padding: 30rpx;
	text-align: center;
	border-top: 1rpx solid #f0f0f0;
	font-size: 22rpx;
	color: #948eb3;
}

/* ===== AI 结果浮层 ===== */
.ai-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: aiMaskFade 0.25s ease;
  overflow: hidden;
  overscroll-behavior: contain;
}

@keyframes aiMaskFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.ai-modal {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.18);
  animation: aiModalUp 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes aiModalUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.ai-modal-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #d8d4e8;
  margin: 18rpx auto 2rpx;
  transition: background 0.2s ease;
}

.ai-modal-handle:active {
  background: #b9b2d6;
}

.ai-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 44rpx 22rpx;
  border-bottom: 1rpx solid #f0f0f4;
}

.ai-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #322c54;
}

.ai-modal-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #948eb3;
  background: #f3f2f8;
  border-radius: 50%;
}

.ai-modal-body {
  flex: 1;
  min-height: 0;
  overscroll-behavior: contain;
}

.ai-modal-body-inner {
  padding: 30rpx 44rpx;
}

.ai-modal-content {
  display: block;
  font-size: 28rpx;
  color: #48416f;
  line-height: 1.75;
  word-break: break-word;
}
