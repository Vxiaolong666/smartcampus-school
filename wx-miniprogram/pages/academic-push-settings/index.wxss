page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 40rpx 30rpx;
}

.loading-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
}

.loading-spinner {
    width: 60rpx;
    height: 60rpx;
    border: 4rpx solid #e0e0e0;
    border-top-color: #13c2c2;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.loading-text {
    margin-top: 20rpx;
    color: #666;
    font-size: 28rpx;
}

.form-card {
    background: white;
    border-radius: 30rpx;
    padding: 50rpx 40rpx;
    margin-top: 25rpx;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08);
}

.card-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 50rpx;
    padding-bottom: 40rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.card-logo {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 20rpx;
}

.card-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 10rpx;
}

.card-desc {
    font-size: 24rpx;
    color: #948eb3;
}

.empty-tip {
    text-align: center;
    padding: 40rpx 0;
}

.empty-tip text {
    font-size: 28rpx;
    color: #948eb3;
}

.bound-info {
    padding: 20rpx 0;
}

.bound-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 2rpx solid #f0f0f0;
}

.bound-item:last-child {
    border-bottom: none;
}

.bound-label {
    font-size: 28rpx;
    color: #948eb3;
}

.bound-value {
    font-size: 28rpx;
    color: #48416f;
    font-weight: bold;
}

.form-item {
    margin-bottom: 36rpx;
}

.form-label {
    font-size: 28rpx;
    color: #48416f;
    margin-bottom: 16rpx;
    font-weight: bold;
}

.form-tip {
    font-size: 24rpx;
    color: #948eb3;
    margin-top: 12rpx;
}

.checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.checkbox-item {
    display: flex;
    align-items: center;
    font-size: 28rpx;
    color: #48416f;
}

.checkbox-item checkbox {
    margin-right: 16rpx;
}

.switch-row {
    display: flex;
    align-items: center;
    gap: 30rpx;
}

.time-picker {
    background: #f7f8fc;
    padding: 16rpx 30rpx;
    border-radius: 16rpx;
    font-size: 28rpx;
    color: #13c2c2;
    border: 2rpx solid #13c2c2;
}

.submit-btn {
    width: 100%;
    height: 96rpx;
    background: #13c2c2;
    color: #fff;
    font-size: 30rpx;
    border-radius: 20rpx;
    font-weight: bold;
    margin-top: 30rpx;
    box-shadow: 0 10rpx 30rpx rgba(19, 194, 194, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
}

.submit-btn:active {
    opacity: 0.9;
    transform: scale(0.98);
}

.menu-card {
    background: white;
    border-radius: 30rpx;
    margin-top: 30rpx;
    padding: 30rpx 40rpx;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08);
}

.menu-title {
    font-size: 28rpx;
    color: #948eb3;
    padding-bottom: 20rpx;
    font-weight: bold;
}

.log-item {
    padding: 24rpx 0;
    border-bottom: 2rpx solid #f0f0f0;
}

.log-item:last-child {
    border-bottom: none;
}

.log-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.log-type text {
    font-size: 26rpx;
    color: #48416f;
}

.log-status {
    font-size: 22rpx;
    padding: 4rpx 16rpx;
    border-radius: 20rpx;
}

.log-status.success {
    background: #f6ffed;
    color: #52c41a;
}

.log-status.failed {
    background: #fff2f0;
    color: #ff4d4f;
}

.log-title {
    font-size: 28rpx;
    color: #48416f;
    margin-bottom: 8rpx;
}

.log-time {
    font-size: 24rpx;
    color: #948eb3;
}
