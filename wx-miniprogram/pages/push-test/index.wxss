page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 30rpx;
}

.card {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    margin-bottom: 24rpx;
    margin-top: 25rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.card-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 12rpx;
}

.card-desc {
    font-size: 26rpx;
    color: #948eb3;
}

.section {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.section-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 20rpx;
}

.section-header .section-title {
    margin-bottom: 0;
}

.clear-btn {
    font-size: 24rpx;
    color: #13c2c2;
}

.openid-info {
    background: #f7f8fc;
    border-radius: 12rpx;
    padding: 20rpx;
    margin-bottom: 20rpx;
}

.openid-label {
    font-size: 24rpx;
    color: #948eb3;
    margin-bottom: 8rpx;
}

.openid-value {
    font-size: 24rpx;
    color: #48416f;
    word-break: break-all;
}

.btn {
    font-size: 28rpx;
    padding: 24rpx;
    border-radius: 12rpx;
    margin: 0;
}

.primary-btn {
    background: #13c2c2;
    color: white;
}

.secondary-btn {
    background: white;
    color: #13c2c2;
    border: 2rpx solid #13c2c2;
}

.form-item {
    margin-bottom: 16rpx;
}

.form-label {
    font-size: 26rpx;
    color: #948eb3;
    margin-bottom: 12rpx;
}

.form-input {
    font-size: 28rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 20rpx;
    border-radius: 12rpx;
}

.form-textarea {
    font-size: 26rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 20rpx;
    border-radius: 12rpx;
    width: 100%;
    min-height: 120rpx;
    box-sizing: border-box;
}

.form-tip {
    font-size: 22rpx;
    color: #c0c0c0;
    margin-top: 8rpx;
}

.subscribe-status {
    margin-top: 16rpx;
    padding: 16rpx;
    border-radius: 8rpx;
    font-size: 26rpx;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
}

.subscribe-icon {
    width: 24rpx;
    height: 24rpx;
    margin-right: 8rpx;
}

.subscribe-status.success {
    background: #f6ffed;
    color: #52c41a;
}

.logs-wrapper {
    background: #f7f8fc;
    border-radius: 12rpx;
    padding: 16rpx;
    max-height: 400rpx;
    overflow-y: auto;
}

.logs-empty {
    text-align: center;
    font-size: 26rpx;
    color: #948eb3;
    padding: 20rpx;
}

.log-item {
    padding: 12rpx;
    margin-bottom: 8rpx;
    background: white;
    border-radius: 8rpx;
    border-left: 6rpx solid #948eb3;
    position: relative;
}

.log-item.success {
    border-left-color: #52c41a;
}

.log-item.error {
    border-left-color: #ff4d4f;
}

.log-item.warning {
    border-left-color: #faad14;
}

.log-item.info {
    border-left-color: #13c2c2;
}

.log-time {
    font-size: 22rpx;
    color: #c0c0c0;
    margin-bottom: 4rpx;
}

.log-message {
    font-size: 24rpx;
    color: #48416f;
    word-break: break-all;
    padding-right: 100rpx;
}

.log-copy {
    position: absolute;
    right: 12rpx;
    bottom: 12rpx;
    font-size: 20rpx;
    color: #13c2c2;
    background: #e8f9f9;
    padding: 4rpx 12rpx;
    border-radius: 6rpx;
}

.form-picker {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 28rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 20rpx;
    border-radius: 12rpx;
}

.picker-arrow {
    font-size: 20rpx;
    color: #948eb3;
}

.template-info {
    background: #f0f5ff;
    border-radius: 12rpx;
    padding: 16rpx;
    margin-top: 16rpx;
}

.template-info-item {
    display: flex;
    font-size: 24rpx;
    margin-bottom: 8rpx;
}

.template-info-item:last-child {
    margin-bottom: 0;
}

.template-info-label {
    color: #948eb3;
    flex-shrink: 0;
}

.template-info-value {
    color: #48416f;
    word-break: break-all;
}

.fields-list {
    background: #f7f8fc;
    border-radius: 12rpx;
    padding: 16rpx;
    margin-top: 12rpx;
}

.fields-title {
    font-size: 24rpx;
    color: #948eb3;
    margin-bottom: 12rpx;
}

.field-item {
    display: inline-block;
    background: white;
    padding: 8rpx 16rpx;
    border-radius: 8rpx;
    margin-right: 12rpx;
    margin-bottom: 8rpx;
    font-size: 22rpx;
}

.field-name {
    color: #48416f;
}

.field-id {
    color: #948eb3;
    margin-left: 4rpx;
}

.subscribe-count-info {
    margin-top: 20rpx;
}

.subscribe-count-badge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 12rpx;
    padding: 20rpx 24rpx;
}

.subscribe-count-badge.has-count {
    background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.subscribe-count-badge.no-count {
    background: linear-gradient(135deg, #ff4d4f 0%, #cf1322 100%);
}

.subscribe-count-label {
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.9);
}

.subscribe-count-value {
    font-size: 40rpx;
    font-weight: bold;
    color: white;
}

.subscribe-count-tip {
    font-size: 24rpx;
    color: #ff4d4f;
    margin-top: 12rpx;
    text-align: center;
}

.version-info {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    background: #f7f8fc;
    border-radius: 12rpx;
    padding: 16rpx 20rpx;
    margin-bottom: 20rpx;
    font-size: 24rpx;
}

.version-label {
    color: #948eb3;
}

.version-value {
    color: #48416f;
    font-weight: 500;
}

.version-divider {
    color: #d1d5db;
    margin: 0 16rpx;
}
