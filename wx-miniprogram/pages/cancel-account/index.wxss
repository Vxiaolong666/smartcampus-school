/* 说明：本页样式与 uniapp 端 pages/cancel-account/index.vue 保持一致（同一套尺寸与配色） */
page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 40rpx 30rpx 80rpx;
}

.state-box {
    background: #fff;
    border-radius: 24rpx;
    padding: 80rpx 40rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, .06);
}

.state-text {
    font-size: 28rpx;
    color: #48416f;
    text-align: center;
    line-height: 1.6;
}

.state-tip {
    font-size: 24rpx;
    color: #948eb3;
    margin-top: 16rpx;
}

/* 步骤指示器 */
.steps {
    display: flex;
    align-items: flex-start;
    margin-bottom: 30rpx;
}

.step {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.step-dot {
    width: 56rpx;
    height: 56rpx;
    border-radius: 50%;
    border: 4rpx solid #dee2e6;
    background: #fff;
    color: #adb5bd;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
}

.step-dot.active {
    border-color: #4c78dd;
    color: #4c78dd;
}

.step-dot.done {
    background: #4c78dd;
    border-color: #4c78dd;
    color: #fff;
}

.dot-check {
    color: #fff;
    font-size: 26rpx;
}

.step-label {
    margin-top: 12rpx;
    font-size: 22rpx;
    color: #948eb3;
    text-align: center;
}

.step-label.label-active {
    color: #4c78dd;
    font-weight: bold;
}

.step-label.label-done {
    color: #495057;
}

.step-line {
    position: absolute;
    top: 27rpx;
    left: 50%;
    width: 100%;
    height: 4rpx;
    background: #e5e7eb;
    z-index: 0;
}

.step-line.line-done {
    background: #4c78dd;
}

/* 表单卡片 */
.form-card {
    background: #fff;
    border-radius: 24rpx;
    padding: 40rpx 30rpx;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, .06);
}

.card-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 24rpx;
}

.agreement-box {
    height: 420rpx;
    background: #fafafa;
    border: 2rpx dashed #e0e0e6;
    border-radius: 16rpx;
    padding: 20rpx;
    margin-bottom: 24rpx;
    box-sizing: border-box;
}

/* 协议容器：内部样式由 Markdown 转换器以内联样式注入 */
.agreement-text {
    display: block;
    font-size: 26rpx;
    color: #48416f;
    line-height: 1.7;
    word-break: break-word;
}

.alert {
    border-radius: 16rpx;
    padding: 20rpx;
    font-size: 26rpx;
    line-height: 1.6;
    margin-bottom: 24rpx;
}

.alert-danger {
    background: #fdecec;
    color: #c0392b;
}

.alert-warning {
    background: #fef5e7;
    color: #b9770e;
}

.risk-list {
    margin-bottom: 24rpx;
}

.risk-title {
    display: block;
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 12rpx;
}

.risk-item {
    display: block;
    font-size: 25rpx;
    color: #6b6786;
    line-height: 1.8;
}

.risk-value {
    color: #c0392b;
    font-weight: bold;
}

.form-item {
    margin-bottom: 32rpx;
}

.form-label {
    font-size: 28rpx;
    color: #48416f;
    margin-bottom: 16rpx;
    font-weight: bold;
}

.form-input {
    width: 100%;
    height: 88rpx;
    padding: 0 30rpx;
    border: 2rpx solid #e5e5e5;
    border-radius: 20rpx;
    font-size: 28rpx;
    box-sizing: border-box;
    background: #f7f8fc;
    color: #48416f;
}

.form-tip {
    display: block;
    font-size: 22rpx;
    color: #948eb3;
    margin-top: 12rpx;
}

.code-row {
    display: flex;
    align-items: center;
}

.code-input {
    flex: 1;
    width: auto;      /* 覆盖 .form-input 的 width:100%，避免与 flex 布局冲突 */
    min-width: 0;
    margin-right: 32rpx;
}

.code-btn {
    margin-left: 0;   /* 间距统一由 .code-input 的 margin-right 控制（button 自带 margin:auto 会吃掉间距） */
    height: 88rpx;
    line-height: 88rpx;
    padding: 0 26rpx;
    font-size: 26rpx;
    color: #13c2c2;
    background: #e6fbfb;
    border-radius: 20rpx;
    border: none;
}

.code-btn::after {
    border: none;
}

.check-row {
    display: flex;
    align-items: flex-start;
    padding: 10rpx 0;
}

.check-box {
    width: 40rpx;
    height: 40rpx;
    border: 3rpx solid #cfd3dc;
    border-radius: 8rpx;
    flex-shrink: 0;
    margin-right: 16rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}

.check-box.checked {
    background: #4c78dd;
    border-color: #4c78dd;
}

.check-icon {
    color: #fff;
    font-size: 26rpx;
}

.check-text {
    flex: 1;
    font-size: 26rpx;
    color: #48416f;
    line-height: 1.5;
}

.phrase-box {
    background: #fafafa;
    border: 2rpx dashed #dc3545;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
}

.phrase-text {
    font-size: 28rpx;
    font-weight: bold;
    color: #dc3545;
    line-height: 1.6;
}

.phrase-input {
    margin-bottom: 8rpx;
}

.nav-buttons {
    display: flex;
    margin-top: 40rpx;
}

/* 与 uniapp 的 gap:24rpx 等效，兼容性更好 */
.nav-buttons .btn + .btn {
    margin-left: 24rpx;
}

.btn {
    flex: 1;
    height: 92rpx;
    line-height: 92rpx;
    border-radius: 20rpx;
    font-size: 30rpx;
    font-weight: bold;
    text-align: center;
    border: none;
    padding: 0;
    margin: 0;
}

.btn::after {
    border: none;
}

.btn-primary {
    background: linear-gradient(135deg, #13c2c2 0%, #10aeff 100%);
    color: #fff;
}

.btn-danger {
    background: #e74c3c;
    color: #fff;
}

.btn-ghost {
    background: #f0f0f5;
    color: #6b6786;
}

/* 不可点击状态：统一为实心浅灰样式（比默认置灰略深，便于辨识） */
.btn[disabled] {
    background: #cfd3dc;
    color: #ffffff;
    opacity: 1;
}

/* 提高选择器权重，覆盖小程序内置的 button[disabled] 默认浅灰样式 */
button.btn.btn-primary[disabled],
button.btn.btn-danger[disabled] {
    background: #cfd3dc;
    color: #ffffff;
    opacity: 1;
}
