<wxs src="../../utils/date.wxs" module="dt" />
<view class="container">
  <top-menu showBack="{{true}}">
    <view class="nav-title">订阅历史记录</view>
  </top-menu>

  <view class="background-wrapper">
    <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
    <view class="background-mask"></view>
  </view>

  <view class="content-wrapper">
    <view class="info-card" wx:if="{{loaded}}">
      <image class="info-icon" src="/assets/wxmp-clock.svg" mode="widthFix"></image>
      <view class="info-content">
        <view class="info-text">共 {{total}} 条历史记录</view>
        <view class="info-sub">包含订阅授权与消息推送记录</view>
      </view>
    </view>

    <view class="tab-bar">
      <view
        wx:for="{{tabs}}"
        wx:key="value"
        class="tab-item {{activeTab === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onChangeTab"
      >{{item.label}}</view>
    </view>

    <cb-load-fail />
    <cb-loading wx:if="{{!loaded}}" />

    <view wx:if="{{loaded && list.length === 0}}" class="empty-wrapper">
      <image class="empty-icon" src="/assets/wxmp-empty.svg" mode="widthFix"></image>
      <view class="empty-text">暂无历史记录</view>
    </view>

    <view wx:if="{{loaded && list.length > 0}}" class="history-list">
      <view wx:for="{{list}}" wx:key="id" class="history-item {{item.source}}">
        <image class="history-icon" src="{{item.icon}}" mode="widthFix"></image>
        <view class="history-body">
          <view class="history-header">
            <view class="history-category">{{item.category}}</view>
            <view class="history-status {{item.statusClass}}">{{item.status_text}}</view>
          </view>
          <view class="history-title">{{item.title}}</view>
          <text wx:if="{{item.content}}" class="history-content">{{item.content}}</text>
          <view wx:if="{{item.status === 2 && item.error_msg}}" class="history-error">失败原因：{{item.error_msg}}</view>
          <view class="history-time">{{dt.formatDateTime(item.time)}}</view>
        </view>
      </view>
    </view>

    <cb-loading wx:if="{{loading && list.length > 0}}" compact />

    <view wx:if="{{!hasMore && list.length > 0}}" class="no-more">
      <view class="no-more-text">没有更多了</view>
    </view>

    <view wx:if="{{showBackTop}}" class="back-top" bindtap="onBackTop">
      <text class="back-top-arrow">↑</text>
    </view>
  </view>
</view>
