page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 40rpx 30rpx;
}

.form-card {
    background: white;
    border-radius: 30rpx;
    padding: 50rpx 40rpx;
    margin-top: 25rpx;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08);
}

.card-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 50rpx;
    padding-bottom: 40rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.card-logo {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 20rpx;
}

.card-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 10rpx;
}

.card-desc {
    font-size: 24rpx;
    color: #948eb3;
}

.form-item {
    margin-bottom: 36rpx;
}

.form-label {
    font-size: 28rpx;
    color: #48416f;
    margin-bottom: 16rpx;
    font-weight: bold;
}

.form-input {
    width: 100%;
    height: 88rpx;
    padding: 0 30rpx;
    border: 2rpx solid #e5e5e5;
    border-radius: 20rpx;
    font-size: 28rpx;
    box-sizing: border-box;
    background: #f7f8fc;
    color: #48416f;
}

.form-input:focus {
    border-color: #13c2c2;
    background: white;
}

.submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 96rpx;
    padding: 0;
    margin: 0;
    margin-top: 30rpx;
    box-sizing: border-box;
    background: #13c2c2;
    color: #fff;
    font-size: 30rpx;
    border-radius: 20rpx;
    font-weight: bold;
    line-height: 1.2;
    box-shadow: 0 10rpx 30rpx rgba(19, 194, 194, 0.3);
}

.submit-btn::after {
    border: none;
}

.submit-btn:active {
    opacity: 0.9;
    transform: scale(0.98);
}

.bound-info {
    padding: 20rpx 0;
}

.bound-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 2rpx solid #f0f0f0;
}

.bound-item:last-child {
    border-bottom: none;
}

.bound-label {
    font-size: 28rpx;
    color: #948eb3;
}

.bound-value {
    font-size: 28rpx;
    color: #48416f;
    font-weight: bold;
}

.action-btns {
    margin-top: 40rpx;
}

.unbind-btn {
    width: 100%;
    height: 88rpx;
    background: #ff7b7b;
    color: #fff;
    font-size: 28rpx;
    border-radius: 20rpx;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
}

.unbind-btn:active {
    opacity: 0.9;
}

.menu-card {
    background: white;
    border-radius: 30rpx;
    margin-top: 30rpx;
    padding: 30rpx 0;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08);
}

.menu-title {
    font-size: 28rpx;
    color: #948eb3;
    padding: 0 40rpx 20rpx;
    font-weight: bold;
}

.menu-item {
    display: flex;
    align-items: center;
    padding: 30rpx 40rpx;
    border-bottom: 2rpx solid #f7f8fc;
}

.menu-item:last-child {
    border-bottom: none;
}

.menu-icon {
    width: 44rpx;
    height: 44rpx;
}

.menu-text {
    flex: 1;
    font-size: 30rpx;
    color: #48416f;
    margin-left: 24rpx;
}

.menu-arrow {
    width: 28rpx;
    height: 28rpx;
    opacity: 0.5;
}
