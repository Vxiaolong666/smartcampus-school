page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .85), rgba(0, 0, 0, .3), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 30rpx;
}

.loading-section, .empty-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
}

.empty-icon {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 20rpx;
}

.loading-spinner {
    width: 60rpx;
    height: 60rpx;
    border: 4rpx solid #e0e0e0;
    border-top-color: #13c2c2;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.loading-text, .empty-text {
    margin-top: 20rpx;
    color: #948eb3;
    font-size: 28rpx;
}

.notice-detail {
    margin-top: 25rpx;
}

.notice-card {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.notice-cover {
    width: 100%;
}

.notice-title {
    padding: 30rpx;
    font-weight: bold;
    font-size: 36rpx;
    color: #48416f;
    line-height: 1.5;
    word-wrap: break-word;
    word-break: break-all;
    white-space: normal;
}

.top-badge {
    display: inline-block;
    background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
    color: white;
    font-size: 24rpx;
    padding: 6rpx 16rpx;
    border-radius: 8rpx;
    margin-right: 16rpx;
    font-weight: normal;
    vertical-align: middle;
}

.notice-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
    font-size: 24rpx;
    color: #948eb3;
    padding: 0 30rpx 30rpx 30rpx;
}

.notice-meta text {
    margin-right: 10rpx;
}

.divider {
    height: 1rpx;
    background: #f0f0f0;
    margin: 20rpx 30rpx;
}

.notice-content {
    padding: 0 30rpx 30rpx 30rpx;
    color: #48416f;
    font-size: 30rpx;
    text-indent: 2em;
    letter-spacing: 2rpx;
    line-height: 1.8;
    word-wrap: break-word;
    word-break: break-all;
    white-space: pre-wrap;
}

.notice-image {
    width: 100%;
    padding: 0 30rpx 30rpx 30rpx;
    box-sizing: border-box;
    border-radius: 12rpx;
}

/* ===== AI 智能总结卡片（内嵌于公告卡片，浅色主题渐变，呼应 #13c2c2→#1890ff 主题） ===== */
.ai-summary-card {
    background: linear-gradient(135deg, #e6f7ff 0%, #f0f5ff 55%, #e6fffb 100%);
    border: 1rpx solid rgba(19, 194, 194, .18);
    border-radius: 20rpx;
    padding: 24rpx 28rpx;
    margin: 0 30rpx 30rpx 30rpx;
    box-shadow: 0 10rpx 30rpx rgba(24, 144, 255, .08);
}

.ai-summary-head {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 16rpx;
}

.ai-summary-badge {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, #13c2c2 0%, #1890ff 100%);
    color: #fff;
    font-size: 22rpx;
    font-weight: 600;
    padding: 6rpx 20rpx;
    border-radius: 999rpx;
    box-shadow: 0 4rpx 12rpx rgba(19, 194, 194, .35);
}

.ai-summary-meta {
    font-size: 22rpx;
    color: #8a94a6;
}

.ai-summary-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #2a303b;
    line-height: 1.4;
    margin-bottom: 14rpx;
}

.ai-summary-tabs {
    display: inline-flex;
    align-items: center;
    gap: 10rpx;
    background: rgba(255, 255, 255, .6);
    border: 1rpx solid rgba(19, 194, 194, .15);
    padding: 8rpx;
    border-radius: 20rpx;
    margin-bottom: 20rpx;
}

.ai-summary-tab {
    font-size: 26rpx;
    font-weight: 600;
    color: #5b6b7b;
    padding: 12rpx 34rpx;
    border-radius: 16rpx;
    transition: color .2s ease, background .2s ease, box-shadow .2s ease;
}

.ai-summary-tab.active {
    color: #fff;
    background: linear-gradient(135deg, #13c2c2 0%, #1890ff 100%);
    box-shadow: 0 4rpx 12rpx rgba(19, 194, 194, .35);
}

.ai-summary-body {
    font-size: 26rpx;
    line-height: 1.8;
    color: #3c4554;
}

.ai-summary-rich {
    font-size: 26rpx;
    line-height: 1.8;
    color: #3c4554;
    word-wrap: break-word;
    word-break: break-all;
}

.ai-summary-loading {
    text-align: center;
    color: #8a94a6;
    padding: 20rpx 0;
    font-size: 26rpx;
}

.ai-summary-foot {
    margin-top: 16rpx;
    padding-top: 14rpx;
    border-top: 1rpx dashed rgba(19, 194, 194, .25);
    font-size: 22rpx;
    color: #8a94a6;
}
