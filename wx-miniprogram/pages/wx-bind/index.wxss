page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 100rpx;
}

.bind-card {
    background: white;
    border-radius: 30rpx;
    padding: 50rpx 40rpx;
    margin-top: 25rpx;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08);
}

.card-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 50rpx;
    padding-bottom: 40rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.card-logo {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 20rpx;
}

.card-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 10rpx;
}

.card-desc {
    font-size: 24rpx;
    color: #948eb3;
}

.status-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40rpx;
}

.status-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20rpx;
}

.status-text {
    font-size: 32rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 8rpx;
}

.status-desc {
    font-size: 24rpx;
    color: #948eb3;
}

.info-section {
    background: #f7f8fc;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 30rpx;
}

.info-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 1rpx solid #e5e5e5;
}

.info-item:last-child {
    border-bottom: none;
}

.info-label {
    font-size: 26rpx;
    color: #948eb3;
}

.info-value {
    font-size: 26rpx;
    color: #48416f;
}

.info-value.openid {
    font-size: 22rpx;
    color: #948eb3;
    max-width: 300rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.bind-btn {
    width: 100%;
    height: 96rpx;
    background: #13c2c2;
    color: #fff;
    font-size: 30rpx;
    border-radius: 20rpx;
    font-weight: bold;
    box-shadow: 0 10rpx 30rpx rgba(19, 194, 194, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
}

.bind-btn:active {
    opacity: 0.9;
    transform: scale(0.98);
}

.unbind-btn {
    width: 100%;
    height: 96rpx;
    background: white;
    color: #ff4d4f;
    font-size: 30rpx;
    border-radius: 20rpx;
    font-weight: bold;
    border: 2rpx solid #ff4d4f;
    display: flex;
    align-items: center;
    justify-content: center;
}

.unbind-btn:active {
    opacity: 0.9;
}

.tips-card {
    background: white;
    border-radius: 30rpx;
    padding: 30rpx 40rpx;
    margin-top: 30rpx;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08);
}

.tips-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 20rpx;
}

.tips-list {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
}

.tips-item {
    font-size: 24rpx;
    color: #948eb3;
    line-height: 1.6;
}
