page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.nav-action {
    padding: 0 30rpx;
}

.action-text {
    font-size: 26rpx;
    color: white;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 100rpx;
}

.filter-card {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-top: 25rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.filter-row {
    display: flex;
    gap: 20rpx;
    margin-bottom: 20rpx;
}

.filter-item {
    flex: 1;
}

.filter-item.half {
    flex: 1;
}

.filter-label {
    font-size: 24rpx;
    color: #948eb3;
    margin-bottom: 8rpx;
}

.filter-value {
    font-size: 28rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 20rpx;
    border-radius: 12rpx;
}

.filter-value-small {
    font-size: 26rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 16rpx;
    border-radius: 12rpx;
}

.room-info {
    margin-bottom: 20rpx;
}

.room-count {
    font-size: 26rpx;
    color: #13c2c2;
}

.query-btn {
    background: #13c2c2;
    color: white;
    font-size: 28rpx;
    padding: 24rpx;
    border-radius: 12rpx;
    margin: 0;
}

.query-btn[disabled] {
    background: #ccc;
}

.progress-card {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.progress-text {
    font-size: 26rpx;
    color: #48416f;
    margin-bottom: 16rpx;
}

.results-wrapper {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.stats-row {
    display: flex;
    gap: 16rpx;
    margin-bottom: 24rpx;
}

.stat-item {
    flex: 1;
    text-align: center;
    padding: 20rpx;
    border-radius: 12rpx;
}

.stat-item.normal {
    background: #f6ffed;
}

.stat-item.warning {
    background: #fffbe6;
}

.stat-item.low {
    background: #fff2f0;
}

.stat-item.arrears {
    background: #f9f0ff;
}

.stat-value {
    font-size: 36rpx;
    font-weight: bold;
}

.stat-item.normal .stat-value {
    color: #52c41a;
}

.stat-item.warning .stat-value {
    color: #faad14;
}

.stat-item.low .stat-value {
    color: #ff4d4f;
}

.stat-item.arrears .stat-value {
    color: #722ed1;
}

.stat-label {
    font-size: 22rpx;
    color: #948eb3;
    margin-top: 4rpx;
}

.result-list {
    max-height: 600rpx;
    overflow-y: auto;
}

.result-item {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 2rpx solid #f0f0f0;
}

.result-item:last-child {
    border-bottom: none;
}

.result-room {
    flex: 1;
    font-size: 28rpx;
    color: #48416f;
}

.result-balance {
    width: 160rpx;
    text-align: right;
    font-size: 28rpx;
    font-weight: bold;
}

.result-item.normal .result-balance {
    color: #52c41a;
}

.result-item.warning .result-balance {
    color: #faad14;
}

.result-item.low .result-balance {
    color: #ff4d4f;
}

.result-item.arrears .result-balance {
    color: #722ed1;
}

.result-status {
    width: 120rpx;
    text-align: right;
    font-size: 24rpx;
    color: #948eb3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.status-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    margin-right: 8rpx;
}

.result-item.normal .status-dot {
    background: #52c41a;
}

.result-item.warning .status-dot {
    background: #faad14;
}

.result-item.low .status-dot {
    background: #ff4d4f;
}

.result-item.arrears .status-dot {
    background: #722ed1;
}

.empty-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 80rpx 0;
    background: white;
    border-radius: 20rpx;
}

.empty-icon {
    width: 60rpx;
    height: 60rpx;
    margin-bottom: 16rpx;
}

.empty-text {
    font-size: 26rpx;
    color: #948eb3;
}

.announcement-wrapper {
    margin-bottom: 20rpx;
}

.announcement-simple {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    padding: 16rpx 24rpx;
    border-radius: 12rpx;
    font-size: 26rpx;
    border: 1rpx solid rgba(59, 130, 246, 0.2);
}
