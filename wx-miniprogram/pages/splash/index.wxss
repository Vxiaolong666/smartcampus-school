.splash-page {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: #000000;
  overflow: hidden;
}

/* 同图模糊背景：填充留白，缓慢流动 */
.splash-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  filter: blur(24px);
  transform: scale(1.4);
  opacity: 0.85;
  z-index: 0;
  will-change: transform, filter;
  animation: splash-bg-flow 4s ease-in-out infinite alternate;
}

/* 模糊背景漂移 + 缩放（保持放大，避免边缘露出） */
@keyframes splash-bg-flow {
  0% {
    transform: scale(1.4) translate3d(-7%, -5%, 0) rotate(-1deg);
    filter: blur(18px);
  }
  33% {
    transform: scale(1.52) translate3d(6%, 5%, 0) rotate(1.2deg);
    filter: blur(26px);
  }
  66% {
    transform: scale(1.44) translate3d(-5%, 7%, 0) rotate(-0.8deg);
    filter: blur(20px);
  }
  100% {
    transform: scale(1.52) translate3d(7%, -5%, 0) rotate(1deg);
    filter: blur(22px);
  }
}

.splash-bg-img {
  width: 100%;
  height: 100%;
}

.splash-image {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: block;
  animation: splash-image-in 0.36s ease-out both;
}

/* 广告图淡入 + 轻微放大，避免生硬切换 */
@keyframes splash-image-in {
  from {
    opacity: 0;
    transform: scale(1.04);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.splash-skip {
  position: absolute;
  /* 实际位置由 js 按状态栏高度设置（style 内联覆盖） */
  top: 120rpx;
  left: 40rpx;
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.38);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(10px);
  z-index: 3;
}

.splash-skip-label {
  opacity: 0.85;
}

/* 倒计时数字：加粗提亮，突出可跳过时间 */
.splash-skip-num {
  margin-left: 6rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.splash-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  padding: 160rpx 48rpx 40rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.28) 45%, rgba(0, 0, 0, 0.72) 100%);
  animation: splash-footer-in 0.5s ease-out both;
}

/* 底部信息栏上滑淡入，与广告图淡入错开 */
@keyframes splash-footer-in {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 品牌胶囊：半透明底 + 细边框，提升层次 */
.splash-brand {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 8rpx 22rpx 8rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.splash-logo {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  margin-right: 14rpx;
  background: #ffffff;
  padding: 4rpx;
  box-sizing: border-box;
}

.splash-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}

/* 广告标识 */
.splash-ad-tag {
  margin-left: 14rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 6rpx;
}

.splash-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 广告免责声明 */
.splash-disclaimer {
  margin-top: 16rpx;
  padding: 0 20rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.55);
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* 底部倒计时进度条 */
.splash-progress {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.18);
  z-index: 4;
}

.splash-progress-bar {
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.6) 0%, #ffffff 100%);
  transform-origin: left center;
  animation-name: splash-progress-shrink;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
}

@keyframes splash-progress-shrink {
  from {
    transform: scaleX(1);
  }
  to {
    transform: scaleX(0);
  }
}

/* 品牌启动页：无广告时清爽白底（渐变 + 主题色光晕） */
.splash-loading {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #ffffff 0%, #f4f8ff 100%);
  z-index: 1;
}

/* 主题色光晕：避免大片纯白显得空 */
.splash-loading-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 620rpx;
  height: 620rpx;
  margin-left: -310rpx;
  margin-top: -400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(19, 194, 194, 0.16) 0%, rgba(24, 144, 255, 0.1) 45%, rgba(24, 144, 255, 0) 72%);
}

/* logo 卡片：白底 + 柔和投影 */
.splash-loading-card {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: 44rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 44rpx rgba(24, 144, 255, 0.18);
}

.splash-loading-logo {
  width: 112rpx;
  height: 112rpx;
}

.splash-loading-name {
  position: relative;
  margin-top: 40rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #1f2d3d;
  letter-spacing: 6rpx;
}

.splash-loading-sub {
  position: relative;
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #8a94a6;
  letter-spacing: 2rpx;
}

/* 底部三点加载动画 */
.splash-loading-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 14vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.splash-loading-dot {
  width: 14rpx;
  height: 14rpx;
  margin: 0 10rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #13c2c2, #1890ff);
  opacity: 0.25;
  animation: splash-dot-pulse 1.2s ease-in-out infinite;
}

.splash-loading-dot:nth-child(2) {
  animation-delay: 0.16s;
}

.splash-loading-dot:nth-child(3) {
  animation-delay: 0.32s;
}

@keyframes splash-dot-pulse {
  0%, 100% { opacity: 0.25; transform: scale(0.75); }
  50% { opacity: 1; transform: scale(1); }
}
