page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.nav-action {
    padding: 0 30rpx;
}

.action-text {
    font-size: 26rpx;
    color: white;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 100rpx;
}

.loading-wrapper {
    display: flex;
    justify-content: center;
    padding: 100rpx 0;
}

.loading-text {
    font-size: 28rpx;
    color: #948eb3;
}

.filter-card {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-top: 25rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.filter-row {
    margin-bottom: 20rpx;
}

.filter-item {
    margin-bottom: 16rpx;
}

.filter-label {
    font-size: 24rpx;
    color: #948eb3;
    margin-bottom: 8rpx;
}

.filter-value {
    font-size: 28rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 20rpx;
    border-radius: 12rpx;
}

.filter-actions {
    display: flex;
    gap: 20rpx;
}

.query-btn {
    flex: 1;
    background: #13c2c2;
    color: white;
    font-size: 28rpx;
    padding: 20rpx;
    border-radius: 12rpx;
    margin: 0;
}

.query-all-btn {
    flex: 1;
    background: white;
    color: #13c2c2;
    font-size: 28rpx;
    padding: 20rpx;
    border-radius: 12rpx;
    margin: 0;
    border: 2rpx solid #13c2c2;
}

.results-wrapper {
    margin-bottom: 24rpx;
}

.result-card {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    margin-bottom: 20rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.result-header {
    padding: 20rpx 24rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.card-normal .result-header {
    background: #52c41a;
}

.card-warning .result-header {
    background: #faad14;
}

.card-low .result-header {
    background: #ff4d4f;
}

.card-arrears .result-header {
    background: #722ed1;
}

.card-error .result-header {
    background: #8c8c8c;
}

.result-name {
    font-size: 28rpx;
    font-weight: bold;
    color: white;
}

.result-status {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
}

.result-body {
    padding: 40rpx 24rpx;
    display: flex;
    align-items: baseline;
    justify-content: center;
}

.balance-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40rpx;
}

.balance-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.balance-divider {
    width: 2rpx;
    height: 80rpx;
    background: #e8e8e8;
}

.balance-value {
    font-size: 56rpx;
    font-weight: bold;
    color: #48416f;
}

.balance-value.primary {
    color: #13c2c2;
}

.balance-value.info {
    color: #1890ff;
}

.balance-unit {
    font-size: 24rpx;
    color: #948eb3;
    margin-top: 8rpx;
}

.estimated-card {
    margin: 0 24rpx 24rpx 24rpx;
    padding: 20rpx 24rpx;
    background: linear-gradient(135deg, #e6f7ff 0%, #f0f5ff 100%);
    border-radius: 16rpx;
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.estimated-icon {
    width: 40rpx;
    height: 40rpx;
}

.estimated-content {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.estimated-label {
    font-size: 26rpx;
    color: #948eb3;
}

.estimated-number {
    font-size: 40rpx;
    font-weight: bold;
    color: #1890ff;
}

.time-range-card {
    margin: 0 24rpx 24rpx 24rpx;
    padding: 20rpx 24rpx;
    background: linear-gradient(135deg, #f6ffed 0%, #e6fffb 100%);
    border-radius: 16rpx;
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.time-range-icon {
    width: 40rpx;
    height: 40rpx;
}

.time-range-content {
    display: flex;
    flex-direction: column;
    gap: 4rpx;
}

.time-range-label {
    font-size: 22rpx;
    color: #948eb3;
}

.time-range-value {
    font-size: 26rpx;
    color: #48416f;
    font-weight: 500;
}

.result-footer {
    padding: 16rpx 24rpx;
    background: #f7f8fc;
}

.result-info {
    font-size: 24rpx;
    color: #948eb3;
}

.empty-result {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60rpx 0;
    background: white;
    border-radius: 20rpx;
    margin-bottom: 24rpx;
}

.empty-icon {
    width: 60rpx;
    height: 60rpx;
    margin-bottom: 16rpx;
}

.empty-text {
    font-size: 26rpx;
    color: #948eb3;
}

.empty-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 80rpx 0;
    background: white;
    border-radius: 20rpx;
    margin-bottom: 24rpx;
}

.empty-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 12rpx;
}

.empty-text {
    font-size: 26rpx;
    color: #948eb3;
    margin-bottom: 24rpx;
}

.bind-btn {
    background: #13c2c2;
    color: white;
    font-size: 28rpx;
    padding: 20rpx 60rpx;
    border-radius: 12rpx;
    margin: 0;
}

.tips-card {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.tips-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 20rpx;
    display: flex;
    align-items: center;
}

.tips-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 10rpx;
}

.tips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.tips-item {
    display: flex;
    align-items: center;
    width: calc(50% - 8rpx);
}

.tips-dot {
    width: 16rpx;
    height: 16rpx;
    border-radius: 50%;
    margin-right: 12rpx;
}

.tips-dot.normal {
    background: #52c41a;
}

.tips-dot.warning {
    background: #faad14;
}

.tips-dot.low {
    background: #ff4d4f;
}

.tips-dot.arrears {
    background: #722ed1;
}

.tips-text {
    font-size: 22rpx;
    color: #948eb3;
}
