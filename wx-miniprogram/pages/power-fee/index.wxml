<view class="container">
  <top-menu showBack="{{true}}">
    <view class="nav-title">电费查询</view>
    <view slot="right" class="nav-action" bindtap="goToBatch">
      <text class="action-text">批量查询</text>
    </view>
  </top-menu>

  <view class="background-wrapper">
    <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
    <view class="background-mask"></view>
  </view>

  <view class="content-wrapper">
    <view wx:if="{{announcement}}">
      <announcement content="{{announcement.content}}" type="{{announcement.type}}" closable="{{true}}" />
    </view>

    <cb-load-fail />
    <cb-loading wx:if="{{loading}}" />

    <block wx:elif="{{dormitories.length > 0}}">
      <view class="filter-card">
        <view class="filter-row">
          <view class="filter-item">
            <view class="filter-label">选择宿舍</view>
            <picker mode="selector" range="{{dormitories}}" range-key="displayName" value="{{selectedIndex}}" bindchange="onPickerChange">
              <view class="filter-value">
                {{selectedIndex >= 0 ? dormitories[selectedIndex].displayName : '请选择宿舍'}}
              </view>
            </picker>
          </view>
        </view>
        <view class="filter-actions">
          <button class="query-btn" bindtap="onQuery" loading="{{queryLoading}}">
            <image class="btn-icon" src="/assets/wxmp-search-white.svg" mode="aspectFit"></image>
            <text>查询</text>
          </button>
          <button class="query-all-btn" bindtap="onQueryAll" loading="{{queryLoading}}">
            <image class="btn-icon" src="/assets/wxmp-list-cyan.svg" mode="aspectFit"></image>
            <text>查询全部</text>
          </button>
        </view>
      </view>

      <view wx:if="{{results.length > 0}}" class="results-wrapper">
        <view class="result-card {{item.status === 'normal' ? 'card-normal' : item.status === 'warning' ? 'card-warning' : item.status === 'low' ? 'card-low' : item.status === 'arrears' ? 'card-arrears' : 'card-error'}}" wx:for="{{results}}" wx:key="id" data-index="{{index}}" bindtap="openDetail">
          <view class="result-header">
            <view class="result-name">{{item.displayName}}</view>
            <view class="result-status">{{item.statusText}}</view>
          </view>
          <view class="result-body">
            <view class="balance-row">
              <view class="balance-item">
                <view class="balance-value">{{item.balance !== null ? item.balance : '--'}}</view>
                <view class="balance-unit">元</view>
              </view>
              <view class="balance-divider"></view>
              <view class="balance-item">
                <view class="balance-value primary">{{item.remainingKwh !== null ? item.remainingKwh : '--'}}</view>
                <view class="balance-unit">度</view>
              </view>
            </view>
          </view>
          <view class="estimated-card" wx:if="{{item.estimatedDaysText !== '--'}}">
            <image class="estimated-icon" src="/assets/wxmp-calendar.svg" mode="aspectFit"></image>
            <view class="estimated-content">
              <view class="estimated-label">预计可用天数</view>
              <view class="estimated-number">{{item.estimatedDaysText}}</view>
              <view class="estimated-label">天</view>
            </view>
          </view>
          <view class="time-range-card" wx:if="{{item.timeRangeText}}">
            <image class="time-range-icon" src="/assets/wxmp-clock.svg" mode="aspectFit"></image>
            <view class="time-range-content">
              <view class="time-range-label">统计时段</view>
              <view class="time-range-value">{{item.timeRangeText}}</view>
            </view>
          </view>
          <view class="result-footer">
            <view class="result-info">{{item.school_area}} · {{item.room_num}}</view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-result">
        <image class="empty-icon" src="/assets/wxmp-bolt.svg" mode="widthFix"></image>
        <view class="empty-text">选择宿舍后点击查询</view>
      </view>
    </block>

    <cb-bind-tip wx:else type="dorm" desc="绑定宿舍后可查询电费" />

    <!-- 结果说明：加载中 / 未绑定宿舍（遮罩）时不展示 -->
    <view class="tips-card" wx:if="{{!loading && dormitories.length > 0}}">
      <view class="tips-title">
        <image class="tips-icon" src="/assets/wxmp-lightbulb.svg" mode="widthFix"></image>
        <text>电费查询结果说明</text>
      </view>
      <view class="tips-list">
        <view class="tips-item">
          <view class="tips-dot normal"></view>
          <view class="tips-text">电量充足：余额大于等于30度</view>
        </view>
        <view class="tips-item">
          <view class="tips-dot warning"></view>
          <view class="tips-text">电量偏低：10度至30度之间</view>
        </view>
        <view class="tips-item">
          <view class="tips-dot low"></view>
          <view class="tips-text">电量不足：余额小于10度</view>
        </view>
        <view class="tips-item">
          <view class="tips-dot arrears"></view>
          <view class="tips-text">已欠费：余额小于等于0度</view>
        </view>
      </view>
    </view>

    <!-- AI 智能分析电费 -->
    <view wx:if="{{!loading && !queryLoading && results.length > 0}}" class="ai-analyze-wrap">
      <view class="ai-analyze-btn {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
        <text wx:if="{{!aiLoading}}">AI 智能分析电费</text>
        <text wx:else>分析中…</text>
      </view>
    </view>
  </view>

  <!-- AI 分析结果浮层 -->
  <view wx:if="{{showAiResult}}" class="ai-mask" bindtap="closeAiResult">
    <view class="ai-modal" style="height: {{sheetHeight}}px" catchtap="noop">
      <view class="ai-modal-handle"></view>
      <view class="ai-modal-header">
        <view class="ai-modal-title-wrap">
          <text class="ai-modal-badge">AI</text>
          <text class="ai-modal-title">智能电费分析</text>
        </view>
        <text class="ai-modal-close" catchtap="closeAiResult">✕</text>
      </view>
      <!-- 正在分析：复用全站统一的圆环 loading，垂直居中 -->
      <view wx:if="{{aiLoading}}" class="ai-modal-center-body">
        <cb-loading class="ai-modal-center-item" compact="{{true}}" large="{{true}}" text="AI 正在分析…"
          subTexts="{{['读取电费数据，约需十几秒', '正在核对余额与用量…', '正在撰写电费建议…', '马上就好，请稍候…']}}"
          slowAfter="{{16000}}" slowText="分析时间有点久…" slowSubText="可稍候，或关闭后重新分析" />
      </view>
      <view wx:elif="{{aiError}}" class="ai-modal-center-body">
        <!-- 分析失败：复用全站统一的网络异常样式，垂直居中 -->
        <view class="ai-error ai-modal-center-item">
          <image class="ai-error-icon" src="/assets/wxmp-network-error.svg" mode="widthFix"></image>
          <view class="ai-error-title">分析失败</view>
          <view class="ai-error-desc">{{aiError}}</view>
          <view class="ai-error-btn" catchtap="aiAnalyze">重新分析</view>
        </view>
      </view>
      <scroll-view wx:else scroll-y="true" class="ai-modal-body" catchtap="noop">
        <view class="ai-modal-body-inner">
          <!-- 分析结果 -->
          <rich-text nodes="{{aiResultHtml}}" class="ai-modal-content"></rich-text>
          <view class="ai-result-foot">内容由 AI 生成，仅供参考</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 右侧浮动 AI 分析按钮 -->
  <view wx:if="{{!loading && results.length > 0}}" class="ai-fab {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
    <text class="ai-fab-icon">AI</text>
    <text class="ai-fab-label">分析</text>
  </view>

  <!-- 电费详情自定义弹窗 -->
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="detail-modal" catchtap="noop">
      <view class="detail-modal-header" style="background: linear-gradient(160deg, {{detailTint.bg}} 0%, #ffffff 100%);">
        <view class="detail-title-wrap">
          <view class="detail-title" style="color: {{detailTint.text}};">{{detailItem.displayName}}</view>
          <view class="detail-sub">
            <text class="detail-sub-chip" style="background-color: {{detailTint.text}};">{{detailItem.statusText}}</text>
          </view>
        </view>
        <view class="detail-close" catchtap="closeDetail">✕</view>
      </view>

      <view class="detail-modal-body">
        <view class="detail-grid">
          <view class="detail-grid-item">
            <view class="detail-grid-num" style="color: {{detailTint.text}};">{{detailItem.balance !== null ? detailItem.balance : '--'}}</view>
            <view class="detail-grid-label">余额（元）</view>
          </view>
          <view class="detail-grid-item">
            <view class="detail-grid-num" style="color: {{detailTint.text}};">{{detailItem.remainingKwh !== null ? detailItem.remainingKwh : '--'}}</view>
            <view class="detail-grid-label">剩余电量（度）</view>
          </view>
          <view class="detail-grid-item">
            <view class="detail-grid-num" style="color: {{detailTint.text}};">{{detailItem.estimatedDaysText}}</view>
            <view class="detail-grid-label">预计可用（天）</view>
          </view>
        </view>

        <view class="detail-row">
          <text class="detail-row-label">电价</text>
          <text class="detail-row-value">{{detailItem.pricePerKwh != null ? detailItem.pricePerKwh + ' 元/度' : '-'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-row-label">统计时段</text>
          <text class="detail-row-value">{{detailItem.timeRangeText || '-'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-row-label">房间位置</text>
          <text class="detail-row-value">{{detailItem.school_area}}{{detailItem.building}} {{detailItem.room_num}}</text>
        </view>

        <button class="detail-btn" catchtap="closeDetail" style="background: linear-gradient(90deg, {{detailTint.text}}, {{detailTint.light}}); box-shadow: 0 10rpx 24rpx {{detailTint.shadow}};">我知道了</button>
      </view>
    </view>
  </view>
</view>
