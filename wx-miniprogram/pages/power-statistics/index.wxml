<wxs src="../../utils/date.wxs" module="dt" />
<view class="container">
    <top-menu showBack="{{true}}">
        <view class="nav-title">用电统计</view>
    </top-menu>

    <view class="background-wrapper">
        <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
        <view class="background-mask"></view>
    </view>

    <view class="content-wrapper">
        <view wx:if="{{announcement}}">
            <announcement content="{{announcement.content}}" type="{{announcement.type}}" closable="{{true}}" />
        </view>

        <cb-load-fail />
        <cb-loading wx:if="{{loading}}" />

        <cb-bind-tip wx:elif="{{dormitories.length === 0}}" type="dorm" desc="绑定宿舍后可查看用电统计" />
        
        <block wx:else>
            <view class="filter-section">
                <view class="filter-item">
                    <text class="filter-label">选择宿舍</text>
                    <picker mode="selector" range="{{dormitories}}" range-key="displayName" value="{{selectedIndex}}" bindchange="onDormitoryChange">
                        <view class="picker-value">
                            <image class="picker-icon" src="/assets/wxmp-home2.svg" mode="widthFix"></image>
                            <text class="picker-text">{{dormitories[selectedIndex].displayName}}</text>
                            <text class="picker-arrow">▼</text>
                        </view>
                    </picker>
                </view>
            </view>
            
            <view class="time-filter">
                <view class="time-filter-btns">
                    <view class="time-btn {{timeRange === 'all' ? 'active' : ''}}" bindtap="setTimeRange" data-range="all">全部</view>
                    <view class="time-btn {{timeRange === '7' ? 'active' : ''}}" bindtap="setTimeRange" data-range="7">近7天</view>
                    <view class="time-btn {{timeRange === '30' ? 'active' : ''}}" bindtap="setTimeRange" data-range="30">近30天</view>
                    <view class="time-btn {{timeRange === 'custom' ? 'active' : ''}}" bindtap="setTimeRange" data-range="custom">自定义</view>
                </view>
                <view wx:if="{{timeRange === 'custom'}}" class="time-custom">
                    <picker mode="date" class="custom-picker" value="{{customStart}}" bindchange="onCustomStart">
                        <view>{{dt.formatDate(customStart) || '开始日期'}}</view>
                    </picker>
                    <text class="custom-sep">至</text>
                    <picker mode="date" class="custom-picker" value="{{customEnd}}" bindchange="onCustomEnd">
                        <view>{{dt.formatDate(customEnd) || '结束日期'}}</view>
                    </picker>
                </view>
            </view>

            <view wx:if="{{stats}}" class="stats-section">
                <view class="stats-header">
                    <image class="stats-header-icon" src="/assets/wxmp-chart.svg" mode="widthFix"></image>
                    <text class="stats-header-title">用电概览</text>
                    <text class="stats-header-period" wx:if="{{periodText}}">{{periodText}}</text>
                </view>
                
                <view class="stats-cards">
                    <view class="stat-card health-{{stats.healthStatus}}">
                        <view class="stat-card-content">
                            <view class="stat-icon-wrapper">
                                <image class="stat-icon" src="/assets/wxmp-heart-{{stats.healthStatus === 'saving' ? 'green' : stats.healthStatus === 'normal' ? 'yellow' : 'red'}}.svg" mode="widthFix"></image>
                            </view>
                            <view class="stat-info">
                                <view class="stat-value">{{stats.healthText}}</view>
                                <view class="stat-label">用电健康度</view>
                            </view>
                        </view>
                    </view>
                    
                    <view class="stat-card info">
                        <view class="stat-card-content">
                            <view class="stat-icon-wrapper">
                                <image class="stat-icon" src="/assets/wxmp-bolt-cyan.svg" mode="widthFix"></image>
                            </view>
                            <view class="stat-info">
                                <view class="stat-value">{{stats.yesterdayUsage}}<text class="stat-unit">度</text></view>
                                <view class="stat-label">昨日用电量</view>
                                <view class="stat-sub">约 ¥{{stats.yesterdayCost}}</view>
                            </view>
                        </view>
                    </view>
                    
                    <view class="stat-card primary">
                        <view class="stat-card-content">
                            <view class="stat-icon-wrapper">
                                <image class="stat-icon" src="/assets/wxmp-trend-blue.svg" mode="widthFix"></image>
                            </view>
                            <view class="stat-info">
                                <view class="stat-value">{{stats.dailyAvgUsage}}<text class="stat-unit">度</text></view>
                                <view class="stat-label">日均用电量</view>
                                <view class="stat-sub">约 ¥{{stats.dailyAvgCost}}/天</view>
                            </view>
                        </view>
                    </view>
                    
                    <view class="stat-card success">
                        <view class="stat-card-content">
                            <view class="stat-icon-wrapper">
                                <image class="stat-icon" src="/assets/wxmp-wallet-green.svg" mode="widthFix"></image>
                            </view>
                            <view class="stat-info">
                                <view class="stat-value">{{stats.latestBalance || '-'}}<text class="stat-unit">元</text></view>
                                <view class="stat-label">当前余额<text wx:if="{{balanceLive}}" class="stat-live">实时</text></view>
                                <view class="stat-sub" wx:if="{{balanceKwhText}}">≈{{balanceKwhText}}度电</view>
                            </view>
                        </view>
                    </view>
                    
                    <view class="stat-card hourly">
                        <view class="stat-card-content">
                            <view class="stat-icon-wrapper">
                                <image class="stat-icon" src="/assets/wxmp-clock.svg" mode="widthFix"></image>
                            </view>
                            <view class="stat-info">
                                <view class="stat-value">{{hourlyAvgUsage}}<text class="stat-unit">度</text></view>
                                <view class="stat-label">平均每小时用电</view>
                                <view class="stat-sub" wx:if="{{hourlyAvgCost !== '-'}}">约 ¥{{hourlyAvgCost}}/时</view>
                            </view>
                        </view>
                    </view>
                    
                    <view class="stat-card estimated" wx:if="{{stats.estimatedDays !== null && stats.estimatedDays !== undefined}}">
                        <view class="stat-card-content">
                            <view class="stat-icon-wrapper">
                                <image class="stat-icon" src="/assets/wxmp-calendar.svg" mode="widthFix"></image>
                            </view>
                            <view class="stat-info">
                                <view class="stat-value">{{stats.estimatedDays}}<text class="stat-unit">天</text></view>
                                <view class="stat-label">预计可用</view>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
            
            <view class="chart-section">
                <view class="section-header">
                    <image class="section-icon" src="/assets/wxmp-activity-teal.svg" mode="widthFix"></image>
                    <text class="section-title">近24小时用电量趋势</text>
                </view>
                <view wx:if="{{recentTrend.length === 0}}" class="no-data">
                    <image class="no-data-icon" src="/assets/wxmp-coffee.svg" mode="widthFix"></image>
                    <text>暂无数据</text>
                </view>
                <line-chart wx:else chartData="{{recentChartData}}" color="{{trendColor}}" unit="度" />
                <view class="chart-footer">
                    <view class="chart-footer-item">
                        <text class="chart-footer-label">数据点</text>
                        <text class="chart-footer-value">{{recentTrend.length}}</text>
                    </view>
                    <view class="chart-footer-item">
                        <text class="chart-footer-label">电价</text>
                        <text class="chart-footer-value">{{pricePerKwh}}元/度</text>
                    </view>
                </view>
                <view class="chart-note">
                    固定展示最近 24 小时数据，不受上方筛选条件影响；其中 06:00 一条为前一晚 23:00-06:00 的整晚合计。
                </view>
            </view>
            
            <view class="chart-section">
                <view class="section-header">
                    <image class="section-icon" src="/assets/wxmp-calendar.svg" mode="widthFix"></image>
                    <text class="section-title">每日用电总量趋势</text>
                </view>
                <view wx:if="{{dailyTrend.length === 0}}" class="no-data">
                    <image class="no-data-icon" src="/assets/wxmp-coffee.svg" mode="widthFix"></image>
                    <text>暂无数据</text>
                </view>
                <line-chart wx:else chartData="{{dailyChartData}}" color="{{trendColor}}" unit="度" />
                <view class="chart-footer">
                    <view class="chart-footer-item">
                        <text class="chart-footer-label">统计天数</text>
                        <text class="chart-footer-value">{{dailyTrend.length}}天</text>
                    </view>
                </view>
            </view>
            
            <view class="records-section">
            <view class="section-header">
                <image class="section-icon" src="/assets/wxmp-list-teal.svg" mode="widthFix"></image>
                <text class="section-title">历史电费记录</text>
                <text class="section-count">共{{records.length}}条</text>
            </view>
            <!-- 筛选与时间排序：同一行下拉选择 -->
            <view class="record-toolbar">
                <picker class="record-picker-wrap" mode="selector" range="{{recordFilterOptions}}" range-key="label" value="{{recordFilterIndex}}" bindchange="onRecordFilterChange">
                    <view class="record-picker {{recordFilter !== 'all' ? 'active' : ''}}">
                        <text class="record-picker-text">{{recordFilterOptions[recordFilterIndex].label}}</text>
                        <text class="record-picker-arrow">▼</text>
                    </view>
                </picker>
                <picker class="record-picker-wrap" mode="selector" range="{{recordSortOptions}}" range-key="label" value="{{recordSortIndex}}" bindchange="onRecordSortChange">
                    <view class="record-picker {{recordSort !== 'desc' ? 'active' : ''}}">
                        <text class="record-picker-text">{{recordSortOptions[recordSortIndex].label}}</text>
                        <text class="record-picker-arrow">▼</text>
                    </view>
                </picker>
            </view>
            <view wx:if="{{recordsLoading}}" class="records-loading">
                <view class="records-loading-spinner"></view>
                <text>加载中…</text>
            </view>
            <view wx:elif="{{records.length === 0}}" class="no-data">
                <image class="no-data-icon" src="/assets/wxmp-coffee.svg" mode="widthFix"></image>
                <text>暂无记录</text>
            </view>
            <view wx:else class="records-timeline">
                    <view wx:for="{{records}}" wx:key="id" class="record-item">
                        <view class="record-timeline-left">
                            <view class="record-dot {{item.usageClass}}"></view>
                            <view class="record-line" wx:if="{{index < records.length - 1}}"></view>
                        </view>
                        <view class="record-content">
                            <view class="record-header">
                                <text class="record-time">{{dt.formatDateTime(item.record_time || item.created_at)}}</text>
                            </view>
                            <view class="record-data">
                                <view class="record-main">
                                    <view class="record-balance">
                                        <text class="record-balance-label">余额</text>
                                        <text class="record-balance-value">¥{{item.balance}}</text>
                                    </view>
                                </view>
                                <view class="record-details" wx:if="{{item.usageDisplay !== '-'}}">
                                    <view class="record-detail-item">
                                        <text class="record-detail-label">用电</text>
                                        <text class="record-detail-value {{item.usageClass}}">{{item.usageDisplay}}度</text>
                                    </view>
                                    <view class="record-detail-item">
                                        <text class="record-detail-label">费用</text>
                                        <text class="record-detail-value {{item.costClass}}">{{item.costDisplay}}元</text>
                                    </view>
                                </view>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="records-footer">
                    用电量根据余额变化和电价({{pricePerKwh}}元/度)自动计算
                </view>
            </view>

            <!-- 趣味账单：周/半月/月账单 + 周期前后翻看（数据由 get_power_bill 独立返回，不受页面筛选影响） -->
            <view class="fun-bill">
                <view class="section-header">
                    <image class="section-icon" src="/assets/wxmp-star.svg" mode="widthFix"></image>
                    <text class="section-title">趣味账单</text>
                    <text wx:if="{{billData && billData.bill}}" class="fun-badge">{{billData.bill.title}}</text>
                </view>

                <!-- 账单类型 -->
                <view class="fun-tabs">
                    <view
                        wx:for="{{billRangeOptions}}"
                        wx:key="value"
                        class="fun-tab {{billRange === item.value ? 'active' : ''}}"
                        data-range="{{item.value}}"
                        bindtap="setBillRange"
                    >{{item.label}}</view>
                </view>

                <!-- 周期选择：◀ 看更早的周期，▶ 回到较新的周期 -->
                <view class="fun-nav">
                    <text class="fun-nav-btn {{!billData || billData.can_prev === false ? 'disabled' : ''}}" bindtap="billPrev">◀</text>
                    <view class="fun-nav-mid">
                        <text class="fun-nav-period">{{billData ? billData.period_text : '加载中…'}}</text>
                        <text wx:if="{{billData && billData.tag}}" class="fun-nav-tag">{{billData.tag}}</text>
                    </view>
                    <text class="fun-nav-btn {{!billOffset ? 'disabled' : ''}}" bindtap="billNext">▶</text>
                </view>

                <view wx:if="{{billData && !billData.has_data}}" class="fun-empty">该周期暂无用电数据，可切换周期查看</view>

                <view wx:if="{{billData && billData.bill}}">
                <view class="fun-totals">
                    <view class="fun-total">
                        <text class="fun-total-value">{{billData.bill.total_usage}}<text class="fun-total-unit">度</text></text>
                        <text class="fun-total-label">周期用电</text>
                    </view>
                    <view class="fun-total-divider"></view>
                    <view class="fun-total">
                        <text class="fun-total-value">{{billData.bill.total_cost}}<text class="fun-total-unit">元</text></text>
                        <text class="fun-total-label">周期电费</text>
                    </view>
                </view>

                <view class="fun-block">
                    <text class="fun-block-title">这些电都够干什么</text>
                    <view class="fun-panel">
                        <view class="fun-row" wx:for="{{billData.bill.equivalents}}" wx:key="index">
                            <text class="fun-row-icon">{{item.icon}}</text>
                            <text class="fun-row-label">{{item.label}}</text>
                            <text class="fun-row-value">{{item.value}}{{item.unit}}</text>
                        </view>
                        <view class="fun-row" wx:if="{{billData.bill.cost_fun}}">
                            <text class="fun-row-icon">{{billData.bill.cost_fun.icon}}</text>
                            <text class="fun-row-label">{{billData.bill.cost_fun.label}}</text>
                            <text class="fun-row-value">{{billData.bill.cost_fun.value}}{{billData.bill.cost_fun.unit}}</text>
                        </view>
                    </view>
                </view>

                <view class="fun-block" wx:if="{{billData.bill.max_day}}">
                    <text class="fun-block-title">用电之最</text>
                    <view class="fun-panel">
                        <view class="fun-extreme">
                            <text class="fun-extreme-tag high">最猛</text>
                            <text class="fun-extreme-date">{{billData.bill.max_day.date}}</text>
                            <text class="fun-extreme-value">{{billData.bill.max_day.usage}} 度</text>
                        </view>
                        <view class="fun-extreme" wx:if="{{billData.bill.min_day}}">
                            <text class="fun-extreme-tag low">最省</text>
                            <text class="fun-extreme-date">{{billData.bill.min_day.date}}</text>
                            <text class="fun-extreme-value">{{billData.bill.min_day.usage}} 度</text>
                        </view>
                    </view>
                </view>

                <view class="fun-block" wx:if="{{billData.bill.night}}">
                    <text class="fun-block-title">夜猫子指数 · {{billData.bill.night.level}}</text>
                    <view class="fun-night-bar">
                        <view class="fun-night-fill" style="width: {{billData.bill.night.ratio}}%;"></view>
                    </view>
                    <text class="fun-night-text">
                        最近 24 小时里，夜间（23:00-06:00）用了 {{billData.bill.night.usage}} 度，占全部用电的 {{billData.bill.night.ratio}}%
                    </text>
                </view>

                <view class="fun-comment">{{billData.bill.comment}}</view>
                </view>
            </view>

            <!-- AI 智能分析用电 -->
            <view wx:if="{{!loading && stats}}" class="ai-analyze-wrap">
                <view class="ai-analyze-btn {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
                    <text wx:if="{{!aiLoading}}">AI 智能分析用电</text>
                    <text wx:else>分析中…</text>
                </view>
            </view>

        </block>
    </view>

    <!-- AI 分析结果浮层 -->
    <view wx:if="{{showAiResult}}" class="ai-mask" bindtap="closeAiResult">
        <view class="ai-modal" style="height: {{sheetHeight}}px" catchtap="noop">
            <wxs module="aiDrag" src="/utils/ai-drag.wxs"></wxs>
            <view class="ai-modal-handle" data-win="{{windowHeight}}" catchtouchstart="{{aiDrag.touchstart}}" catchtouchmove="{{aiDrag.touchmove}}" catchtouchend="{{aiDrag.touchend}}"></view>
            <view class="ai-modal-header">
                <view class="ai-modal-title-wrap">
                    <text class="ai-modal-badge">AI</text>
                    <text class="ai-modal-title">智能用电分析</text>
                </view>
                <text class="ai-modal-close" catchtap="closeAiResult">✕</text>
            </view>
            <!-- 正在分析：复用全站统一的圆环 loading，垂直居中 -->
            <view wx:if="{{aiLoading}}" class="ai-modal-center-body">
                <cb-loading class="ai-modal-center-item" compact="{{true}}" large="{{true}}" text="AI 正在分析…"
                    subTexts="{{['读取用电数据，约需十几秒', '正在分析用电趋势…', '正在撰写用电建议…', '马上就好，请稍候…']}}"
                    slowAfter="{{16000}}" slowText="分析时间有点久…" slowSubText="可稍候，或关闭后重新分析" />
            </view>
            <view wx:elif="{{aiError}}" class="ai-modal-center-body">
                <!-- 分析失败：复用全站统一的网络异常样式，垂直居中 -->
                <view class="ai-error ai-modal-center-item">
                    <image class="ai-error-icon" src="/assets/wxmp-network-error.svg" mode="widthFix"></image>
                    <view class="ai-error-title">分析失败</view>
                    <view class="ai-error-desc">{{aiError}}</view>
                    <view class="ai-error-btn" catchtap="aiAnalyze">重新分析</view>
                </view>
            </view>
            <scroll-view wx:else scroll-y="true" class="ai-modal-body" catchtap="noop">
                <view class="ai-modal-body-inner">
                    <!-- 分析结果 -->
                    <rich-text nodes="{{aiResultHtml}}" class="ai-modal-content"></rich-text>
                    <view class="ai-result-foot">内容由 AI 生成，仅供参考</view>
                </view>
            </scroll-view>
        </view>
    </view>

    <!-- 右侧浮动 AI 分析按钮 -->
    <view wx:if="{{!loading && dormitories.length > 0}}" class="ai-fab {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
        <text class="ai-fab-icon">AI</text>
        <text class="ai-fab-label">分析</text>
    </view>
</view>
