page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 30rpx;
}

.filter-section {
    display: flex;
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-top: 25rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.filter-item {
    flex: 1;
}

.filter-label {
    font-size: 24rpx;
    color: #948eb3;
    margin-bottom: 12rpx;
    display: block;
}

.picker-value {
    display: flex;
    align-items: center;
    padding: 20rpx 24rpx;
    background: linear-gradient(135deg, #f7f8fc 0%, #eff1ff 100%);
    border-radius: 16rpx;
    border: 2rpx solid #e8eaf6;
}

.picker-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 16rpx;
}

.picker-text {
    flex: 1;
    font-size: 28rpx;
    color: #48416f;
    font-weight: 500;
}

.picker-arrow {
    font-size: 20rpx;
    color: #948eb3;
    margin-left: 8rpx;
}

.loading-section, .empty-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
}

.empty-icon {
    width: 120rpx;
    height: 120rpx;
    margin-bottom: 24rpx;
    opacity: 0.6;
}

.empty-title {
    font-size: 32rpx;
    color: #48416f;
    font-weight: bold;
    margin-bottom: 12rpx;
}

.loading-spinner {
    width: 60rpx;
    height: 60rpx;
    border: 4rpx solid #e0e0e0;
    border-top-color: #13c2c2;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.loading-text, .empty-text {
    margin-top: 20rpx;
    color: #948eb3;
    font-size: 28rpx;
}

.stats-section {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.stats-header {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
    padding-bottom: 16rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.stats-header-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 12rpx;
}

.stats-header-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #48416f;
}

.stats-header-period {
    margin-left: auto;
    padding-left: 16rpx;
    font-size: 22rpx;
    color: #948eb3;
}

.stats-cards {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.stat-card {
    flex: 1;
    min-width: 45%;
    background: white;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stat-card-content {
    display: flex;
    align-items: center;
    padding: 20rpx 24rpx;
}

.stat-icon-wrapper {
    width: 56rpx;
    height: 56rpx;
    border-radius: 14rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 16rpx;
    flex-shrink: 0;
}

.stat-card.health-saving .stat-icon-wrapper {
    background: rgba(40, 167, 69, 0.1);
}

.stat-card.health-normal .stat-icon-wrapper {
    background: rgba(255, 193, 7, 0.1);
}

.stat-card.health-high .stat-icon-wrapper {
    background: rgba(220, 53, 69, 0.1);
}

.stat-card.info .stat-icon-wrapper {
    background: rgba(23, 162, 184, 0.1);
}

.stat-card.primary .stat-icon-wrapper {
    background: rgba(0, 123, 255, 0.1);
}

.stat-card.success .stat-icon-wrapper {
    background: rgba(40, 167, 69, 0.1);
}

.stat-card.estimated .stat-icon-wrapper {
    background: rgba(0, 123, 255, 0.1);
}

.stat-card.hourly .stat-icon-wrapper {
    background: rgba(19, 194, 194, 0.12);
}

.stat-icon {
    width: 28rpx;
    height: 28rpx;
}

.stat-info {
    flex: 1;
}

.stat-value {
    font-size: 32rpx;
    font-weight: bold;
    line-height: 1.2;
    color: #48416f;
}

.stat-unit {
    font-size: 20rpx;
    font-weight: normal;
    color: #948eb3;
    margin-left: 4rpx;
}

.stat-label {
    font-size: 22rpx;
    color: #948eb3;
    margin-top: 4rpx;
}

.stat-sub {
    font-size: 20rpx;
    color: #948eb3;
    margin-top: 4rpx;
}

.chart-section {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.section-header {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

.section-icon {
    width: 32rpx;
    height: 32rpx;
    margin-right: 12rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #48416f;
    flex: 1;
}

.section-count {
    font-size: 22rpx;
    color: #948eb3;
    background: #f5f5f5;
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
}

.chart-footer {
    display: flex;
    justify-content: center;
    gap: 40rpx;
    padding-top: 16rpx;
    margin-top: 16rpx;
    border-top: 2rpx solid #f5f5f5;
}

.chart-footer-item {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.chart-footer-label {
    font-size: 22rpx;
    color: #948eb3;
}

.chart-footer-value {
    font-size: 22rpx;
    color: #48416f;
    font-weight: 500;
}

/* 图表下方口径说明（如「近24小时」「06:00 为整晚合计」） */
.chart-note {
    margin-top: 12rpx;
    font-size: 22rpx;
    color: #948eb3;
    line-height: 1.6;
    text-align: center;
}

/* ==================== 趣味账单 ==================== */
/* 与上方卡片（.chart-section）一致的白色卡片样式 */
.fun-bill {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

/* 账单类型：周 / 半月 / 月 */
.fun-tabs {
    display: flex;
    margin-top: 20rpx;
    padding: 6rpx;
    background: #f7f8fc;
    border-radius: 16rpx;
}

.fun-tab {
    flex: 1;
    text-align: center;
    padding: 12rpx 0;
    font-size: 24rpx;
    color: #6b6485;
    border-radius: 12rpx;
}

.fun-tab.active {
    color: #ffffff;
    background: linear-gradient(135deg, #13c2c2 0%, #0ea5a5 100%);
    font-weight: 600;
}

/* 周期选择：◀ 周期 ▶（左右箭头往中间收，不贴卡片两侧） */
.fun-nav {
    display: flex;
    align-items: center;
    margin-top: 16rpx;
    padding: 0 60rpx;
}

.fun-nav-btn {
    width: 56rpx;
    height: 56rpx;
    line-height: 56rpx;
    text-align: center;
    font-size: 22rpx;
    color: #13c2c2;
    background: #f7f8fc;
    border-radius: 50%;
}

.fun-nav-btn.disabled {
    color: #c8c4d6;
}

.fun-nav-mid {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.fun-nav-period {
    font-size: 26rpx;
    font-weight: 600;
    color: #1f1a33;
}

.fun-nav-tag {
    margin-top: 2rpx;
    font-size: 22rpx;
    color: #948eb3;
}

.fun-empty {
    margin-top: 20rpx;
    padding: 30rpx 0;
    text-align: center;
    font-size: 24rpx;
    color: #948eb3;
    background: #f7f8fc;
    border-radius: 16rpx;
}

.fun-badge {
    padding: 6rpx 18rpx;
    font-size: 22rpx;
    color: #ffffff;
    background: linear-gradient(135deg, #13c2c2 0%, #0ea5a5 100%);
    border-radius: 24rpx;
}

.fun-totals {
    display: flex;
    align-items: center;
    margin-top: 24rpx;
    padding: 20rpx 0;
    background: #f7f8fc;
    border-radius: 16rpx;
}

.fun-total {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.fun-total-divider {
    width: 2rpx;
    height: 56rpx;
    background: #f0f0f5;
}

.fun-total-value {
    font-size: 40rpx;
    font-weight: bold;
    color: #13c2c2;
}

.fun-total-unit {
    margin-left: 4rpx;
    font-size: 22rpx;
    font-weight: normal;
}

.fun-total-label {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #948eb3;
}

.fun-block {
    margin-top: 24rpx;
}

.fun-block-title {
    font-size: 24rpx;
    font-weight: 600;
    color: #48416f;
}

.fun-row {
    display: flex;
    align-items: center;
    margin-top: 14rpx;
}

.fun-row-icon {
    font-size: 30rpx;
}

.fun-row-label {
    flex: 1;
    margin-left: 14rpx;
    font-size: 26rpx;
    color: #48416f;
}

.fun-row-value {
    font-size: 26rpx;
    font-weight: 600;
    color: #13c2c2;
}

.fun-extreme {
    display: flex;
    align-items: center;
    margin-top: 14rpx;
}

.fun-extreme-tag {
    padding: 2rpx 14rpx;
    font-size: 22rpx;
    border-radius: 8rpx;
}

.fun-extreme-tag.high {
    color: #ff4d4f;
    background: #fff1f0;
}

.fun-extreme-tag.low {
    color: #52c41a;
    background: #f6ffed;
}

.fun-extreme-date {
    flex: 1;
    margin-left: 14rpx;
    font-size: 26rpx;
    color: #48416f;
}

.fun-extreme-value {
    font-size: 26rpx;
    font-weight: 600;
    color: #1f1a33;
}

.fun-night-bar {
    margin-top: 16rpx;
    height: 16rpx;
    background: #edf2f7;
    border-radius: 8rpx;
    overflow: hidden;
}

.fun-night-fill {
    height: 100%;
    background: linear-gradient(90deg, #13c2c2 0%, #52c41a 100%);
    border-radius: 8rpx;
}

.fun-night-text {
    display: block;
    margin-top: 12rpx;
    font-size: 22rpx;
    color: #948eb3;
    line-height: 1.6;
}

.fun-comment {
    margin-top: 24rpx;
    padding-top: 20rpx;
    border-top: 2rpx solid #eef2f6;
    font-size: 24rpx;
    color: #6b6485;
    line-height: 1.7;
}

.no-data {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60rpx 0;
    color: #948eb3;
}

.no-data-icon {
    width: 80rpx;
    height: 80rpx;
    margin-bottom: 16rpx;
    opacity: 0.5;
}

.records-section {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.records-timeline {
    max-height: 600rpx;
    overflow-y: auto;
}

.record-item {
    display: flex;
    min-height: 120rpx;
}

.record-timeline-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 32rpx;
    flex-shrink: 0;
    margin-right: 20rpx;
}

.record-dot {
    width: 16rpx;
    height: 16rpx;
    border-radius: 50%;
    background: #13c2c2;
    flex-shrink: 0;
    margin-top: 8rpx;
    box-shadow: 0 0 0 4rpx rgba(19, 194, 194, 0.2);
}

.record-dot.usage-down {
    background: #dc3545;
    box-shadow: 0 0 0 4rpx rgba(220, 53, 69, 0.2);
}

.record-dot.usage-up {
    background: #28a745;
    box-shadow: 0 0 0 4rpx rgba(40, 167, 69, 0.2);
}

.record-line {
    flex: 1;
    width: 2rpx;
    background: linear-gradient(to bottom, #e0e0e0, #f0f0f0);
    margin-top: 4rpx;
}

.record-content {
    flex: 1;
    padding-bottom: 20rpx;
}

.record-header {
    margin-bottom: 12rpx;
}

.record-time {
    font-size: 24rpx;
    color: #948eb3;
}

.record-data {
    background: #f8f9fc;
    border-radius: 12rpx;
    padding: 16rpx;
}

.record-main {
    margin-bottom: 12rpx;
}

.record-balance {
    display: flex;
    align-items: baseline;
    gap: 8rpx;
}

.record-balance-label {
    font-size: 22rpx;
    color: #948eb3;
}

.record-balance-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #48416f;
}

.record-details {
    display: flex;
    gap: 24rpx;
    padding-top: 12rpx;
    border-top: 2rpx solid #e8eaf6;
}

.record-detail-item {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.record-detail-label {
    font-size: 22rpx;
    color: #948eb3;
}

.record-detail-value {
    font-size: 24rpx;
    font-weight: 500;
    color: #48416f;
}

.usage-down {
    color: #dc3545;
}

.usage-up {
    color: #28a745;
}

.records-footer {
    text-align: center;
    padding-top: 16rpx;
    margin-top: 16rpx;
    border-top: 2rpx solid #f5f5f5;
    font-size: 22rpx;
    color: #948eb3;
}

/* 筛选 + 时间排序：同一行两个下拉选择 */
.record-toolbar {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 20rpx;
}

.record-picker-wrap {
    flex: 1;
    min-width: 0;
}

.record-picker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14rpx 20rpx;
    border-radius: 12rpx;
    background: #f5f6fa;
    border: 2rpx solid transparent;
    box-sizing: border-box;
}

.record-picker.active {
    background: rgba(19, 194, 194, 0.1);
    border-color: rgba(19, 194, 194, 0.5);
}

.record-picker-text {
    flex: 1;
    min-width: 0;
    font-size: 24rpx;
    color: #48416f;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.record-picker.active .record-picker-text {
    color: #13c2c2;
    font-weight: 500;
}

.record-picker-arrow {
    flex-shrink: 0;
    margin-left: 8rpx;
    font-size: 18rpx;
    color: #948eb3;
}

.record-picker.active .record-picker-arrow {
    color: #13c2c2;
}

.records-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    padding: 40rpx 0;
    font-size: 26rpx;
    color: #948eb3;
}

.records-loading-spinner {
    width: 32rpx;
    height: 32rpx;
    border: 3rpx solid #e0e0e0;
    border-top-color: #13c2c2;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

.stat-live {
    display: inline-block;
    margin-left: 8rpx;
    padding: 0 10rpx;
    font-size: 18rpx;
    line-height: 1.6;
    color: #13c2c2;
    background: rgba(19, 194, 194, 0.12);
    border-radius: 8rpx;
}

.time-filter {
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: 20rpx;
    padding: 20rpx 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.time-filter-btns {
    display: flex;
    gap: 16rpx;
}

.time-btn {
    flex: 1;
    text-align: center;
    font-size: 26rpx;
    color: #48416f;
    padding: 16rpx 0;
    border-radius: 14rpx;
    background: #f5f6fa;
    border: 2rpx solid transparent;
}

.time-btn.active {
    background: #13c2c2;
    color: #fff;
}

.time-custom {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-top: 20rpx;
}

.custom-picker {
    flex: 1;
    min-height: 76rpx;
    line-height: 72rpx;
    text-align: center;
    font-size: 26rpx;
    color: #48416f;
    border-radius: 14rpx;
    background: #f5f6fa;
    border: 2rpx solid #e3e0f0;
    box-sizing: border-box;
}

.custom-sep {
    font-size: 26rpx;
    color: #948eb3;
}
