<view class="container">
  <top-menu showBack="{{true}}">
    <view class="nav-title">登录</view>
  </top-menu>

  <view class="background-wrapper">
    <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
    <view class="background-mask"></view>
  </view>

  <view class="content-wrapper">
    <view class="logo-section">
      <image class="logo" src="/assets/wxmp-logo.svg" mode="widthFix"></image>
      <view class="app-name">校园服务</view>
      <view class="app-desc">便捷的校园生活助手</view>
    </view>

    <view class="form-card">
      <view class="card-header">
        <image class="card-icon" src="/assets/wxmp-user.svg" mode="widthFix"></image>
        <text class="card-title">账号登录</text>
      </view>

      <view class="form-item">
        <view class="input-wrapper">
          <image class="input-icon" src="/assets/wxmp-user.svg" mode="widthFix"></image>
          <input 
            class="form-input" 
            type="text" 
            placeholder="请输入用户名" 
            value="{{username}}"
            bindinput="onUsernameInput"
          />
        </view>
      </view>
      
      <view class="form-item">
        <view class="input-wrapper">
          <image class="input-icon" src="/assets/wxmp-lock.svg" mode="widthFix"></image>
          <input 
            class="form-input" 
            type="password" 
            placeholder="请输入密码" 
            value="{{password}}"
            bindinput="onPasswordInput"
          />
        </view>
      </view>

      <view class="forgot-link" bindtap="onForgot">忘记密码？</view>
      <view class="verify-link" bindtap="onSendVerify">未验证邮箱？</view>

      <button class="login-btn" bindtap="onLogin" loading="{{loading}}">
        <text>登 录</text>
      </button>

      <view class="divider">
        <view class="divider-line"></view>
        <text class="divider-text">其他登录方式</text>
        <view class="divider-line"></view>
      </view>

      <button class="wx-login-btn" bindtap="onWxLogin" loading="{{wxLoading}}">
        <image class="wx-icon" src="/assets/wxmp-wechat.svg" mode="widthFix"></image>
        <text>微信一键登录</text>
      </button>

      <view class="register-link">
        <text>还没有账号？</text>
        <text class="link" bindtap="onRegister">立即注册</text>
      </view>
    </view>
  </view>
</view>
