page {
    background: #eff1ff;
}

.title {
    height: 100%;
    display: flex;
    align-items: center;
    padding-left: 40rpx;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
}

.school-selector {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    padding: 16rpx 0 0;
    margin-left: -50rpx;
}

.school-selector-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 8rpx;
}

.school-selector-name {
    font-size: 26rpx;
    color: white;
    letter-spacing: 1rpx;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.background-subject {
    position: relative;
    color: white;
    padding: 30rpx;
}

.background-subject-subtitle {
    font-size: 30rpx;
}

.background-subject-title {
    font-size: 50rpx;
    font-weight: bold;
}

.background-subject-poem {
    font-size: 24rpx;
    opacity: 0.8;
    margin-top: 12rpx;
    letter-spacing: 2rpx;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 450rpx;
    min-height: 50vh;
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 24rpx 30rpx;
}

.content-menus {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
}

.content-menus-sub {
    margin-top: -16rpx;
    margin-bottom: 30rpx;
}

.content-menus-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: white;
    border-radius: 24rpx;
    border: 1rpx solid #f0f0f5;
    padding: 20rpx 0;
    margin-right: 16rpx;
}

.content-menus-item:last-child {
    margin-right: 0;
}

.content-menus-item-logo {
    width: 64rpx;
    height: 64rpx;
}

.content-menus-item-text {
    font-size: 24rpx;
    color: #48416f;
    font-weight: 500;
    white-space: nowrap;
    margin-top: 12rpx;
}

.content-menus-item-h {
    flex-direction: row;
    justify-content: center;
    padding: 24rpx 0;
}

.content-menus-item-logo-sm {
    width: 44rpx;
    height: 44rpx;
}

.content-menus-item-h .content-menus-item-text {
    margin-top: 0;
    margin-left: 12rpx;
}


.content-ctrls {
    margin-top: 30rpx;
    display: flex;
    height: 300rpx;
}

.content-ctrls-left {
    background: white;
    height: 100%;
    width: 100%;
    border-radius: 30rpx 0 30rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.content-ctrls-left-decor {
    position: absolute;
    right: -10rpx;
    bottom: -10rpx;
    width: 160rpx;
    height: 140rpx;
    pointer-events: none;
}

.content-ctrls-left-text {
    margin-top: 30rpx;
    color: #5a5477;
    font-weight: bold;
    font-size: 30rpx;
}

.content-ctrls-right {
    display: flex;
    flex-direction: column;
    flex: 1;
}


.content-ctrls-right-top {
    background: white;
    border-radius: 0 30rpx 0 30rpx;
    flex: 1;
    margin-bottom: 30rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.content-ctrls-right-text {
    color: #5a5477;
    font-weight: bold;
    font-size: 30rpx;
    margin-left: 20rpx;
}

.content-ctrls-right-bottom {
    background: white;
    border-radius: 30rpx 0 30rpx 0;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
}

.content-notices {
    display: flex;
    flex-direction: column;
    margin-top: 30rpx;
    padding-bottom: 15rpx;
}

.content-notice {
    padding: 30rpx;
    border-radius: 30rpx;
    font-size: 24rpx;
    margin-bottom: 20rpx;
    display: flex;
    position: relative;
    overflow: hidden;
}

.content-notice-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

.content-notice-cover,
.content-notice-info {
    position: relative;
    z-index: 1;
}

.content-notice-cover {
    width: 200rpx;
    height: 120rpx;
    border-radius: 20rpx;
}

.content-notice-info {
    display: flex;
    flex-direction: column;
    padding-left: 30rpx;
    flex: 1;
}

.content-notice-title {
    font-size: 28rpx;
    flex: 1;
    color: #48416f;
    font-weight: bold;
}

.top-badge {
    display: inline-block;
    background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
    color: white;
    font-size: 20rpx;
    padding: 4rpx 12rpx;
    border-radius: 6rpx;
    margin-right: 10rpx;
    font-weight: normal;
    vertical-align: middle;
}

.content-notice-date {
    text-align: right;
    color: #948eb3;
}

.content-notice-more {
    text-align: center;
    color: #5a5477;
    font-size: 26rpx;
    text-decoration: underline;
}

.subscription-alert {
    background: white;
    border-radius: 30rpx;
    margin-bottom: 30rpx;
    overflow: hidden;
}

.subscription-alert-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 30rpx;
}

.subscription-alert-title {
    font-size: 26rpx;
    color: #e74c3c;
    font-weight: bold;
}

.subscription-alert-arrow {
    width: 32rpx;
    height: 32rpx;
}

.content-swiper {
    margin-bottom: 30rpx;
}

.swiper {
    width: 100%;
    height: 280rpx;
    border-radius: 20rpx;
    overflow: hidden;
}

.swiper-image {
    width: 100%;
    height: 100%;
}

.glance-section {
    margin-bottom: 30rpx;
}

.glance-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 20rpx;
    padding-left: 20rpx;
    position: relative;
}

.glance-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6rpx;
    height: 28rpx;
    background: linear-gradient(180deg, #ff6348 0%, #ee5a24 100%);
    border-radius: 3rpx;
}

.glance-cards {
    display: flex;
    gap: 20rpx;
}

.glance-card {
    flex: 1;
    background: white;
    border-radius: 20rpx;
    padding: 28rpx 24rpx;
    position: relative;
    overflow: hidden;
}

.glance-decor {
    position: absolute;
    right: -10rpx;
    bottom: -10rpx;
    width: 140rpx;
    height: 120rpx;
    opacity: 0.15;
    pointer-events: none;
}

.glance-card-content {
    display: flex;
    flex-direction: column;
}

.glance-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.glance-card-label {
    font-size: 22rpx;
    color: #948eb3;
    font-weight: 500;
    padding-left: 16rpx;
    position: relative;
}

.glance-card-label::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6rpx;
    height: 22rpx;
    border-radius: 3rpx;
}

.glance-course .glance-card-label::before {
    background: #00b894;
}

.glance-power .glance-card-label::before {
    background: #f39c12;
}

.glance-card-value {
    font-size: 30rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 6rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.glance-card-info {
    font-size: 22rpx;
    color: #948eb3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tag-normal {
    color: #00b894;
    background: rgba(0, 184, 148, 0.1);
}

.tag-active {
    color: #27ae60;
    background: rgba(39, 174, 96, 0.1);
}

.tag-warning {
    color: #f39c12;
    background: rgba(243, 156, 18, 0.1);
}

.tag-urgent {
    color: #e74c3c;
    background: rgba(231, 76, 60, 0.1);
}

.glance-card-tag {
    display: inline-block;
    font-size: 20rpx;
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
}

.ctrls-section {
    margin-top: 30rpx;
    margin-bottom: 20rpx;
}

.ctrls-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 20rpx;
    padding-left: 20rpx;
    position: relative;
}

.ctrls-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6rpx;
    height: 28rpx;
    background: linear-gradient(180deg, #9b59b6 0%, #8e44ad 100%);
    border-radius: 3rpx;
}

.notices-section {
    margin-top: 30rpx;
    margin-bottom: 30rpx;
}

.notices-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 20rpx;
    padding-left: 20rpx;
    position: relative;
}

.notices-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6rpx;
    height: 28rpx;
    background: linear-gradient(180deg, #00b894 0%, #00a381 100%);
    border-radius: 3rpx;
}

/* ===== 开屏广告 ===== */
.splash-mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 2000;
    background: #000000;
}

.splash-image {
    width: 100%;
    height: 100%;
    display: block;
}

.splash-skip {
    position: absolute;
    top: 100rpx;
    left: 40rpx;
    padding: 10rpx 28rpx;
    font-size: 26rpx;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.45);
    border: 1rpx solid rgba(255, 255, 255, 0.4);
    border-radius: 999rpx;
}

/* 底部品牌栏：应用 logo + 名称 + 跳转提示 */
.splash-footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 80rpx 40rpx 40rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 100%);
}

.splash-brand {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.splash-logo {
    width: 60rpx;
    height: 60rpx;
    border-radius: 14rpx;
    margin-right: 16rpx;
    background: #ffffff;
    padding: 6rpx;
    box-sizing: border-box;
}

.splash-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 2rpx;
}

.splash-hint {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.85);
}