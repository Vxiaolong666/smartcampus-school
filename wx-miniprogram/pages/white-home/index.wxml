<page-meta page-style="{{splashVisible ? 'overflow:hidden;' : ''}}"></page-meta>
<wxs src="../../utils/date.wxs" module="dt" />
<view>
  <view class="background-wrapper">
   
    <top-menu>
      <view class="school-selector">
      <image class="school-selector-icon" src="/assets/wxmp-location-white.svg" mode="aspectFit" />
      <text class="school-selector-name">广东茂名幼儿师范专科学校</text>
    </view>
    </top-menu>
    <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
    <view class="background-mask"></view>
    <view class="background-subject">
      <view class="background-subject-title">欢迎回来，{{apiUserInfo.username || '用户'}}</view>
      <view class="background-subject-poem">{{randomPoem}}</view>
      <!-- 今日日期 + 当前教学周（教务未返回周次时只显示日期） -->
      <view wx:if="{{todayText}}" class="background-subject-meta">
        <text class="background-subject-date">{{todayText}}</text>
        <view wx:if="{{currentWeek > 0}}" class="background-subject-week">当前第{{currentWeek}}周</view>
      </view>
    </view>
  </view>

  <view class="content-wrapper">
    <view wx:if="{{indexAnnouncement}}">
      <announcement content="{{indexAnnouncement.content}}" type="{{indexAnnouncement.type}}" closable="{{true}}" />
    </view>

    <view wx:if="{{lowSubscriptions.length > 0}}" class="subscription-alert" bind:tap="handleSubscription">
      <view class="subscription-alert-content">
        <text class="subscription-alert-title">有{{lowSubscriptions.length}}个订阅次数不足，点击增加</text>
        <image class="subscription-alert-arrow" src="/assets/wxmp-right.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="content-swiper">
      <swiper class="swiper" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#ffffff" autoplay="{{true}}" interval="{{4000}}" circular="{{true}}" duration="{{500}}">
        <swiper-item wx:for="{{swiperList}}" wx:key="id">
          <image class="swiper-image" src="{{item.image}}" mode="aspectFill" bind:tap="handleSwiperTap" data-url="{{item.url}}" />
        </swiper-item>
      </swiper>
    </view>

    <view class="content-menus">
      <view class="content-menus-item" bind:tap="handleDormitoryBind">
        <image class="content-menus-item-logo" src="/assets/icon-one/ssbd.svg" mode="aspectFit" />
        <view class="content-menus-item-text">宿舍绑定</view>
      </view>
      <view class="content-menus-item" bind:tap="handleStudentInfo">
        <image class="content-menus-item-logo" src="/assets/icon-one/jwbd.svg" mode="aspectFit" />
        <view class="content-menus-item-text">学籍信息</view>
      </view>
      <view class="content-menus-item" bind:tap="handlePowerStatistics">
        <image class="content-menus-item-logo" src="/assets/icon-one/tssz.svg" mode="aspectFit" />
        <view class="content-menus-item-text">用电记录</view>
      </view>
    </view>

    <view class="content-menus content-menus-sub">
      <view class="content-menus-item content-menus-item-h" bind:tap="handlePushSettings">
        <image class="content-menus-item-logo content-menus-item-logo-sm" src="/assets/icon-one/ydtj.svg" mode="aspectFit" />
        <view class="content-menus-item-text">电费推送设置</view>
      </view>
      <view class="content-menus-item content-menus-item-h" bind:tap="handleAcademicPushSettings">
        <image class="content-menus-item-logo content-menus-item-logo-sm" src="/assets/icon-one/cjts.svg" mode="aspectFit" />
        <view class="content-menus-item-text">学术推送设置</view>
      </view>
    </view>

    <view class="glance-section">
      <view class="glance-cards">
        <view class="glance-card glance-course" bind:tap="handleTodaySchedule">
          <view class="glance-card-content">
            <block wx:if="{{nextCourse}}">
              <view class="glance-card-header">
                <view class="glance-card-label">课程信息</view>
                <view class="glance-card-tag {{nextCourse.statusClass}}">{{nextCourse.statusText}}</view>
              </view>
              <view class="glance-card-value">{{nextCourse.courseName}}</view>
              <view class="glance-card-info">{{nextCourse.timeDisplay}}<text wx:if="{{nextCourse.location}}"> · {{nextCourse.location}}</text></view>
            </block>
            <block wx:elif="{{courseLoadError}}">
              <view class="glance-card-header">
                <view class="glance-card-label">课程信息</view>
              </view>
              <view class="glance-card-value">加载失败</view>
              <view class="glance-card-info">点击重新加载</view>
            </block>
            <block wx:elif="{{allCoursesEnded}}">
              <view class="glance-card-header">
                <view class="glance-card-label">课程信息</view>
              </view>
              <view class="glance-card-value">今日课程已结束</view>
              <view class="glance-card-info">好好休息吧~</view>
            </block>
            <block wx:elif="{{!isLoggedIn}}">
              <view class="glance-card-header">
                <view class="glance-card-label">课程信息</view>
              </view>
              <view class="glance-card-value">登录后查看</view>
              <view class="glance-card-info">点击前往登录</view>
            </block>
            <block wx:else>
              <view class="glance-card-header">
                <view class="glance-card-label">下一节课</view>
              </view>
              <view class="glance-card-value">暂无课程</view>
              <view class="glance-card-info">今天没有课哦</view>
            </block>
          </view>
          <image class="glance-decor" src="/assets/hhhh.svg" mode="aspectFit" />
        </view>
        <view class="glance-card glance-power" bind:tap="handlePowerFee">
          <view class="glance-card-content">
            <block wx:if="{{powerInfo}}">
              <view class="glance-card-header">
                <view class="glance-card-label">电费余额</view>
                <view class="glance-card-tag {{powerInfo.statusClass}}">{{powerInfo.statusText}}</view>
              </view>
              <view class="glance-card-value">¥{{powerInfo.balance}}</view>
              <view class="glance-card-info">{{powerInfo.roomName}}</view>
            </block>
            <block wx:elif="{{noDormitory}}">
              <view class="glance-card-header">
                <view class="glance-card-label">电费余额</view>
              </view>
              <view class="glance-card-value">未绑定宿舍</view>
              <view class="glance-card-info">请先绑定宿舍</view>
            </block>
            <block wx:elif="{{!isLoggedIn}}">
              <view class="glance-card-header">
                <view class="glance-card-label">电费余额</view>
              </view>
              <view class="glance-card-value">登录后查看</view>
              <view class="glance-card-info">点击前往登录</view>
            </block>
            <block wx:else>
              <view class="glance-card-header">
                <view class="glance-card-label">电费余额</view>
              </view>
              <view class="glance-card-value">加载中...</view>
              <view class="glance-card-info">正在获取电费信息</view>
            </block>
          </view>
          <image class="glance-decor" src="/assets/xinxin.svg" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="ctrls-section">
      <view class="ctrls-title">快捷功能</view>
      <view class="content-ctrls">
      <view style="flex:1.2;padding-right:30rpx">
        <view class="content-ctrls-left" bind:tap="handleSchedule">
          <image class="content-ctrls-left-decor" src="/assets/heart_reate_detecting_bottom_icon.png" mode="aspectFit" />
          <image src="/assets/myclass.svg" mode="aspectFill" style="width:140rpx;height:140rpx"></image>
          <view class="content-ctrls-left-text">我的课程表</view>
        </view>
      </view>
      <view class="content-ctrls-right">
        <view class="content-ctrls-right-top" bind:tap="handleGrade">
          <image src="/assets/chenj.svg" mode="aspectFit" style="width:70rpx;height:70rpx"></image>
          <view class="content-ctrls-right-text">成绩查询</view>
        </view>
        <view class="content-ctrls-right-bottom" bind:tap="handlePowerFee">
          <image src="/assets/dianf.svg" mode="aspectFit" style="width:70rpx;height:70rpx"></image>
          <view class="content-ctrls-right-text">电费查询</view>
        </view>
      </view>
      </view>
    </view>

    <view class="notices-section">
      <view class="notices-title">通知公告</view>
      <view class="content-notices">
        <view wx:for="{{notices}}" wx:key="id" class="content-notice" data-id="{{item.id}}" bind:tap="handleNotice">
          <image class="content-notice-bg" src="/assets/score_dialog_bg1.png" mode="aspectFill"></image>
          <image wx:if="{{item.cover}}" class="content-notice-cover" src="{{item.cover}}" mode="aspectFill" />
          <view class="content-notice-info">
            <view class="content-notice-title">
              <text wx:if="{{item.is_top == 1}}" class="top-badge">置顶</text>
              {{item.title}}
            </view>
            <view class="content-notice-date">{{dt.formatDateTime(item.create_time)}}</view>
          </view>
        </view>
        <view class="content-notice-more" bind:tap="handleNotices">查看更多</view>
      </view>
    </view>
  </view>

  <!-- 右下角浮动刷新按钮（独立样式：纯白底 + 黑色图标，刷新整个首页数据） -->
  <view class="home-refresh-fab {{pageRefreshing ? 'home-refresh-fab-loading' : ''}}" bindtap="handlePageRefresh">
    <image class="home-refresh-icon" src="/assets/wxmp-refresh-black.svg" mode="aspectFit"></image>
  </view>

  <!-- 开屏广告 -->
  <view class="splash-mask" wx:if="{{splashVisible}}" catch:touchmove="noop">
    <!-- 同图模糊背景：铺满整屏填充留白；前面仍完整展示广告原图（不裁切） -->
    <image class="splash-bg" src="{{splashImage}}" mode="aspectFill"></image>
    <image class="splash-image" src="{{splashImage}}" mode="aspectFit" bind:tap="handleSplashTap"></image>
    <view class="splash-skip" bind:tap="closeSplash">跳过 {{splashCountdown}}s</view>
    <view class="splash-footer" bind:tap="handleSplashTap">
      <view class="splash-brand">
        <image class="splash-logo" src="/assets/wxmp-logo.svg" mode="aspectFit"></image>
        <text class="splash-name">{{splashName}}</text>
      </view>
      <view wx:if="{{splashUrl}}" class="splash-hint">点击跳转到详情页</view>
    </view>
  </view>
</view>
