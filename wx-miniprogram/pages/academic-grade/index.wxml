<view class="container">
  <top-menu showBack="{{true}}">
    <view class="nav-title">成绩查询</view>
  </top-menu>

  <view class="background-wrapper">
    <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
    <view class="background-mask"></view>
  </view>

  <view class="content-wrapper">
    <view wx:if="{{announcement}}">
      <announcement content="{{announcement.content}}" type="{{announcement.type}}" closable="{{true}}" />
    </view>

    <view class="filter-card" wx:if="{{!needBind && (semesters.length > 0 || !loading)}}">
      <view class="filter-row">
        <view class="filter-item">
          <view class="filter-label">学期</view>
          <picker mode="selector" range="{{semesters}}" range-key="semesterName" value="{{semesterIndex}}" bindchange="onSemesterChange">
            <view class="filter-value">{{semesters[semesterIndex].semesterName || '请选择'}}</view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 本学期统计（学期筛选下方） -->
    <view wx:if="{{!loading && grades.length > 0}}" class="summary-card">
      <view class="summary-title">本学期统计</view>
      <view class="summary-row">
        <view class="summary-item">
          <view class="summary-value">{{summary.totalCourses}}</view>
          <view class="summary-label">课程数</view>
        </view>
        <view class="summary-item">
          <view class="summary-value">{{summary.earnedCredits}}</view>
          <view class="summary-label">已修学分</view>
        </view>
        <view class="summary-item">
          <view class="summary-value">{{summary.avgGpa}}</view>
          <view class="summary-label">平均绩点</view>
        </view>
      </view>
    </view>

    <cb-load-fail />
    <cb-loading wx:if="{{loading}}" />

    <cb-bind-tip wx:elif="{{needBind}}" type="academic" desc="绑定后可查询成绩" />

    <view wx:elif="{{grades.length === 0}}" class="empty-wrapper">
      <image class="empty-icon" src="/assets/wxmp-read.svg" mode="widthFix"></image>
      <view class="empty-text">暂无成绩数据</view>
    </view>

    <view wx:else class="grade-list">
      <view class="grade-item" wx:for="{{grades}}" wx:key="index" data-index="{{index}}" bindtap="openDetail">
        <view class="grade-header">
          <view class="grade-name">{{item.courseName}}</view>
          <view class="grade-score {{item.scoreClass}}">{{item.score}}</view>
        </view>
        <view class="grade-info">
          <view class="grade-info-item">
            <text class="info-label">学分：</text>
            <text class="info-value">{{item.credit}}</text>
          </view>
          <view class="grade-info-item">
            <text class="info-label">绩点：</text>
            <text class="info-value">{{item.gpa || '-'}}</text>
          </view>
          <view class="grade-info-item">
            <text class="info-label">类型：</text>
            <text class="info-value">{{item.courseType || '-'}}</text>
          </view>
        </view>
      </view>

      <!-- AI 智能分析成绩 -->
      <view wx:if="{{!loading && grades.length > 0}}" class="ai-analyze-wrap">
        <view class="ai-analyze-btn {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
          <text wx:if="{{!aiLoading}}">AI 智能分析成绩</text>
          <text wx:else>分析中…</text>
        </view>
      </view>
    </view>
  </view>

  <!-- AI 分析结果浮层 -->
  <view wx:if="{{showAiResult}}" class="ai-mask" bindtap="closeAiResult">
    <view class="ai-modal" style="height: {{sheetHeight}}px" catchtap="noop">
      <view class="ai-modal-handle"></view>
      <view class="ai-modal-header">
        <view class="ai-modal-title-wrap">
          <text class="ai-modal-badge">AI</text>
          <text class="ai-modal-title">智能成绩分析</text>
        </view>
        <text class="ai-modal-close" catchtap="closeAiResult">✕</text>
      </view>
      <!-- 正在分析：复用全站统一的圆环 loading，垂直居中 -->
      <view wx:if="{{aiLoading}}" class="ai-modal-center-body">
        <cb-loading class="ai-modal-center-item" compact="{{true}}" large="{{true}}" text="AI 正在分析…"
          subTexts="{{['读取成绩数据，约需十几秒', '正在汇总学分与绩点…', '正在撰写成绩分析…', '马上就好，请稍候…']}}"
          slowAfter="{{16000}}" slowText="分析时间有点久…" slowSubText="可稍候，或关闭后重新分析" />
      </view>
      <view wx:elif="{{aiError}}" class="ai-modal-center-body">
        <!-- 分析失败：复用全站统一的网络异常样式，垂直居中 -->
        <view class="ai-error ai-modal-center-item">
          <image class="ai-error-icon" src="/assets/wxmp-network-error.svg" mode="widthFix"></image>
          <view class="ai-error-title">分析失败</view>
          <view class="ai-error-desc">{{aiError}}</view>
          <view class="ai-error-btn" catchtap="aiAnalyze">重新分析</view>
        </view>
      </view>
      <scroll-view wx:else scroll-y="true" class="ai-modal-body" catchtap="noop">
        <view class="ai-modal-body-inner">
          <!-- 分析结果 -->
          <rich-text nodes="{{aiResultHtml}}" class="ai-modal-content"></rich-text>
          <view class="ai-result-foot">内容由 AI 生成，仅供参考</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 右侧浮动 AI 分析按钮 -->
  <view wx:if="{{!loading && !needBind && grades.length > 0}}" class="ai-fab {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
    <text class="ai-fab-icon">AI</text>
    <text class="ai-fab-label">分析</text>
  </view>

  <!-- 成绩详情自定义弹窗 -->
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="detail-modal" catchtap="noop">
      <view class="detail-modal-header" style="background: linear-gradient(160deg, {{detailTint.bg}} 0%, #ffffff 100%);">
        <view class="detail-title-wrap">
          <view class="detail-title" style="color: {{detailTint.text}};">{{detailItem.courseName}}</view>
          <view class="detail-sub">
            <text class="detail-sub-chip" style="background-color: {{detailTint.text}};">{{detailItem.score}} 分</text>
          </view>
        </view>
        <view class="detail-close" catchtap="closeDetail">✕</view>
      </view>

      <view class="detail-modal-body">
        <view class="detail-grid">
          <view class="detail-grid-item">
            <view class="detail-grid-num" style="color: {{detailTint.text}};">{{detailItem.credit}}</view>
            <view class="detail-grid-label">学分</view>
          </view>
          <view class="detail-grid-item">
            <view class="detail-grid-num" style="color: {{detailTint.text}};">{{detailItem.gpa || '-'}}</view>
            <view class="detail-grid-label">绩点</view>
          </view>
          <view class="detail-grid-item">
            <view class="detail-grid-num" style="color: {{detailTint.text}};">{{detailItem.courseType || '-'}}</view>
            <view class="detail-grid-label">课程类型</view>
          </view>
        </view>

        <button class="detail-btn" catchtap="closeDetail" style="background: linear-gradient(90deg, {{detailTint.text}}, {{detailTint.light}}); box-shadow: 0 10rpx 24rpx {{detailTint.shadow}};">我知道了</button>
      </view>
    </view>
  </view>
</view>
