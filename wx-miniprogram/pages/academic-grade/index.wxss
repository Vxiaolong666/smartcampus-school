page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 30rpx;
}

.filter-card {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx 30rpx;
    margin-top: 25rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.filter-row {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.filter-item {
    flex: 1;
}

.filter-label {
    font-size: 24rpx;
    color: #948eb3;
    margin-bottom: 8rpx;
}

.filter-value {
    font-size: 28rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 16rpx 20rpx;
    border-radius: 12rpx;
}

.query-btn {
    background: #13c2c2;
    color: white;
    font-size: 28rpx;
    padding: 0 30rpx;
    height: 72rpx;
    line-height: 72rpx;
    border-radius: 12rpx;
    margin: 0;
}

.loading-wrapper {
    display: flex;
    justify-content: center;
    padding: 100rpx 0;
}

.loading-text {
    font-size: 28rpx;
    color: #948eb3;
}

.empty-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
}

.empty-icon {
    width: 120rpx;
    height: 120rpx;
    opacity: 0.5;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #948eb3;
}

.grade-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.grade-item {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.grade-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.grade-name {
    font-size: 30rpx;
    color: #48416f;
    font-weight: bold;
    flex: 1;
    margin-right: 20rpx;
}

.grade-score {
    font-size: 36rpx;
    font-weight: bold;
    padding: 8rpx 24rpx;
    border-radius: 12rpx;
}

.grade-score.pass {
    background: #e8f9f9;
    color: #13c2c2;
}

.grade-score.fail {
    background: #fff0f0;
    color: #ff7b7b;
}

.grade-info {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.grade-info-item {
    font-size: 24rpx;
}

.info-label {
    color: #948eb3;
}

.info-value {
    color: #48416f;
}

.summary-card {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    margin-top: 20rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.summary-title {
    font-size: 28rpx;
    color: #48416f;
    font-weight: bold;
    margin-bottom: 24rpx;
    text-align: center;
}

.summary-row {
    display: flex;
    justify-content: space-around;
}

.summary-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.summary-value {
    font-size: 40rpx;
    color: #13c2c2;
    font-weight: bold;
}

.summary-label {
    font-size: 24rpx;
    color: #948eb3;
    margin-top: 8rpx;
}
