page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 30rpx;
}

.filter-card {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx 30rpx;
    margin-top: 25rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.filter-row {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.filter-item {
    flex: 1;
}

.filter-label {
    font-size: 24rpx;
    color: #948eb3;
    margin-bottom: 8rpx;
}

.filter-value {
    font-size: 28rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 16rpx 20rpx;
    border-radius: 12rpx;
}

.query-btn {
    background: #13c2c2;
    color: white;
    font-size: 28rpx;
    padding: 0 30rpx;
    height: 72rpx;
    line-height: 72rpx;
    border-radius: 12rpx;
    margin: 0;
}

.loading-wrapper {
    display: flex;
    justify-content: center;
    padding: 100rpx 0;
}

.loading-text {
    font-size: 28rpx;
    color: #948eb3;
}

.empty-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
}

.empty-icon {
    width: 120rpx;
    height: 120rpx;
    opacity: 0.5;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #948eb3;
}

.grade-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.grade-item {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.grade-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.grade-name {
    font-size: 30rpx;
    color: #48416f;
    font-weight: bold;
    flex: 1;
    margin-right: 20rpx;
}

.grade-score {
    font-size: 36rpx;
    font-weight: bold;
    padding: 8rpx 24rpx;
    border-radius: 12rpx;
}

/* 60 以下：红色 */
.grade-score.fail {
    background: #fff0f0;
    color: #ff4d4f;
}

/* 85 及以上：绿色 */
.grade-score.excellent {
    background: #f6ffed;
    color: #52c41a;
}

/* 其它（60~85 及非数字）：蓝色主题色 */
.grade-score.normal {
    background: #e8f9f9;
    color: #13c2c2;
}

.grade-info {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.grade-info-item {
    font-size: 24rpx;
}

.info-label {
    color: #948eb3;
}

.info-value {
    color: #48416f;
}

.summary-card {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.summary-title {
    font-size: 28rpx;
    color: #48416f;
    font-weight: bold;
    margin-bottom: 24rpx;
    text-align: center;
}

.summary-row {
    display: flex;
    justify-content: space-around;
}

.summary-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.summary-value {
    font-size: 40rpx;
    color: #13c2c2;
    font-weight: bold;
}

.summary-label {
    font-size: 24rpx;
    color: #948eb3;
    margin-top: 8rpx;
}

/* ==================== 成绩详情自定义弹窗 ==================== */

.grade-item:active {
    opacity: 0.92;
}

.detail-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(50, 44, 84, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 998;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60rpx;
    animation: detailMaskFade 0.25s ease;
}

@keyframes detailMaskFade {
    from { opacity: 0; }
    to { opacity: 1; }
}

.detail-modal {
    width: 100%;
    max-width: 620rpx;
    background: white;
    border-radius: 32rpx;
    overflow: hidden;
    box-shadow: 0 24rpx 80rpx rgba(50, 44, 84, 0.25);
    animation: detailModalUp 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes detailModalUp {
    from { transform: translateY(80rpx) scale(0.96); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
}

.detail-modal-header {
    display: flex;
    align-items: flex-start;
    padding: 36rpx 32rpx 28rpx;
}

.detail-title-wrap {
    flex: 1;
    min-width: 0;
}

.detail-title {
    font-size: 36rpx;
    font-weight: bold;
    line-height: 1.35;
    word-break: break-all;
    letter-spacing: 1rpx;
}

.detail-sub {
    margin-top: 16rpx;
}

.detail-sub-chip {
    display: inline-block;
    font-size: 22rpx;
    color: white;
    padding: 8rpx 22rpx;
    border-radius: 999rpx;
    letter-spacing: 1rpx;
}

.detail-close {
    width: 52rpx;
    height: 52rpx;
    line-height: 50rpx;
    text-align: center;
    font-size: 26rpx;
    color: #948eb3;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    flex-shrink: 0;
    margin-left: 16rpx;
    box-shadow: 0 4rpx 12rpx rgba(50, 44, 84, 0.08);
}

.detail-close:active {
    background: #f0eef6;
    transform: scale(0.92);
}

.detail-modal-body {
    padding: 8rpx 36rpx 40rpx;
}

.detail-grid {
    display: flex;
    gap: 20rpx;
    margin-top: 12rpx;
}

.detail-grid-item {
    flex: 1;
    background: #f7f8fc;
    border-radius: 20rpx;
    padding: 24rpx 20rpx;
    text-align: center;
}

.detail-grid-num {
    font-size: 30rpx;
    font-weight: bold;
    color: #13c2c2;
    word-break: break-all;
}

.detail-grid-label {
    font-size: 22rpx;
    color: #948eb3;
    margin-top: 8rpx;
}

.detail-btn {
    margin-top: 36rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 42rpx;
    color: white;
    font-size: 30rpx;
    font-weight: bold;
    letter-spacing: 4rpx;
    padding: 0;
}

.detail-btn:active {
    opacity: 0.85;
    transform: scale(0.98);
}

.detail-btn::after {
    border: none;
}
