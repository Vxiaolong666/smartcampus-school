page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 30rpx;
}

.info-card {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-top: 25rpx;
    margin-bottom: 24rpx;
    display: flex;
    align-items: center;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.info-icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.info-text {
    font-size: 26rpx;
    color: #48416f;
}

.loading-wrapper {
    display: flex;
    justify-content: center;
    padding: 100rpx 0;
}

.loading-text {
    font-size: 28rpx;
    color: #948eb3;
}

.dorm-list {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.dorm-item {
    padding: 24rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.dorm-item:last-child {
    border-bottom: none;
}

.dorm-info {
    margin-bottom: 16rpx;
}

.dorm-name {
    font-size: 30rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 8rpx;
}

.default-tag {
    font-size: 22rpx;
    color: white;
    background: #13c2c2;
    padding: 4rpx 12rpx;
    border-radius: 6rpx;
    margin-left: 12rpx;
    font-weight: normal;
}

.dorm-detail {
    font-size: 24rpx;
    color: #948eb3;
    margin-bottom: 4rpx;
}

.dorm-time {
    font-size: 22rpx;
    color: #c0c0c0;
}

.dorm-actions {
    display: flex;
    gap: 16rpx;
}

.action-btn {
    font-size: 24rpx;
    padding: 14rpx 18rpx;
    border-radius: 8rpx;
    margin: 0;
    line-height: 1.4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
}

.action-btn::after {
    border: none;
}

.btn-icon {
    width: 24rpx;
    height: 24rpx;
    margin-right: 6rpx;
}

.default-btn {
    background: #e8f9f9;
    color: #13c2c2;
    border: 2rpx solid #13c2c2;
}

.unbind-btn {
    background: #fff0f0;
    color: #ff4d4f;
    border: 2rpx solid #ff4d4f;
}

.empty-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 80rpx 0;
    background: white;
    border-radius: 20rpx;
    margin-bottom: 24rpx;
}

.empty-icon {
    width: 80rpx;
    height: 80rpx;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #948eb3;
}

.btn-group {
    display: flex;
    gap: 20rpx;
    margin-top: 30rpx;
    margin-bottom: 24rpx;
}

.primary-btn {
    flex: 1;
    background: #13c2c2;
    color: white;
    font-size: 28rpx;
    padding: 24rpx;
    border-radius: 16rpx;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.primary-btn::after {
    border: none;
}

.secondary-btn {
    flex: 1;
    background: white;
    color: #13c2c2;
    font-size: 28rpx;
    padding: 24rpx;
    border-radius: 16rpx;
    margin: 0;
    border: 2rpx solid #13c2c2;
    display: flex;
    align-items: center;
    justify-content: center;
}

.secondary-btn::after {
    border: none;
}

.primary-btn .btn-icon,
.secondary-btn .btn-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 8rpx;
}

.modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
}

.modal-content {
    width: 100%;
    background: white;
    border-top-left-radius: 32rpx;
    border-top-right-radius: 32rpx;
    animation: slideUp 0.3s ease;
}

@keyframes slideUp {
    from {
        transform: translateY(100%);
    }
    to {
        transform: translateY(0);
    }
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #48416f;
}

.modal-close {
    font-size: 48rpx;
    color: #948eb3;
    line-height: 1;
}

.modal-body {
    padding: 30rpx;
}

.form-item {
    margin-bottom: 24rpx;
}

.form-label {
    font-size: 26rpx;
    color: #948eb3;
    margin-bottom: 12rpx;
}

.form-value {
    font-size: 28rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 20rpx;
    border-radius: 12rpx;
}

.form-input {
    font-size: 28rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 20rpx;
    border-radius: 12rpx;
}

.modal-footer {
    display: flex;
    padding: 20rpx 30rpx 40rpx;
    gap: 20rpx;
}

.modal-btn {
    flex: 1;
    font-size: 28rpx;
    padding: 24rpx;
    border-radius: 12rpx;
    margin: 0;
}

.cancel-btn {
    background: #f7f8fc;
    color: #948eb3;
}

.confirm-btn {
    background: #13c2c2;
    color: white;
}
