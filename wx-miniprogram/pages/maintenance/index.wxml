<view class="container">
  <top-menu showBack="{{false}}">
    <view class="nav-title">系统维护</view>
  </top-menu>

  <view class="background-wrapper">
    <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
    <view class="background-mask"></view>
  </view>

  <view class="content-wrapper">
    <cb-loading wx:if="{{loading}}" />

    <view wx:else class="maintenance-card">
      <view class="card-header">
        <image class="card-logo" src="/assets/wxmp-logo.svg" mode="widthFix"></image>
        <view class="card-title">系统维护中</view>
        <view class="type-badge" wx:if="{{typeLabel}}">{{typeLabel}}</view>
      </view>

      <view class="maintenance-content">
        <view class="maintenance-icon-wrapper">
          <image class="maintenance-icon" src="{{manualOnly ? iconShield : '/assets/wxmp-clock.svg'}}" mode="widthFix"></image>
        </view>

        <!-- 每日例行维护 -->
        <view wx:if="{{dailyActive}}" class="reason-card">
          <view class="reason-head">
            <image class="reason-icon-img" src="{{iconClock}}" mode="aspectFit"></image>
            <view class="reason-title-wrap">
              <view class="reason-title">每日例行维护</view>
              <view class="reason-sub">受学校教务系统每晚关闭维护影响</view>
            </view>
          </view>
          <view class="reason-body">
            <view class="reason-row">
              <text class="reason-label">维护时段</text>
              <text class="reason-value">{{maintenanceTime}}</text>
            </view>
            <view class="reason-row">
              <text class="reason-label">当前时间</text>
              <text class="reason-value">{{currentTime}}</text>
            </view>
            <view class="reason-row" wx:if="{{countdown}}">
              <text class="reason-label">预计恢复</text>
              <text class="reason-value countdown">{{countdown}} 后</text>
            </view>
            <view class="reason-desc">{{recoverDesc}}</view>
          </view>
        </view>

        <!-- 管理员开启维护 -->
        <view wx:if="{{manualActive}}" class="reason-card manual">
          <view class="reason-head">
            <image class="reason-icon-img" src="{{iconShield}}" mode="aspectFit"></image>
            <view class="reason-title-wrap">
              <view class="reason-title">系统正在维护</view>
              <view class="reason-sub">不便之处敬请谅解</view>
            </view>
          </view>
          <view class="reason-body">
            <!-- 后台配置的实际维护信息 -->
            <view class="notice-box" wx:if="{{notice}}">
              <view class="notice-title">功能维护公告</view>
              <view class="notice-content">{{notice.content}}</view>
            </view>
            <view class="notice-box" wx:else>
              <view class="notice-content">系统正在维护，恢复时间待定，请留意公告或稍后再试。</view>
            </view>
          </view>
        </view>

        <view class="maintenance-section">
          <view class="section-title">温馨提示</view>
          <view class="section-text">
            如需紧急帮助，可点击下方「联系客服」与我们取得联系。系统恢复后重新进入即可正常使用。
          </view>
        </view>
      </view>

      <view class="maintenance-footer">
        <!-- 一行两个按钮：联系客服（主）+ 重新检测（次） -->
        <view class="footer-actions">
          <view class="action-btn action-primary" bindtap="openContactGuide">联系客服</view>
          <button class="action-btn action-plain" bindtap="onRecheck">重新检测</button>
        </view>
        <view class="footer-text">感谢您的耐心等待，我们会尽快恢复。</view>
      </view>
    </view>
  </view>

  <contact-guide id="contactGuide" />
</view>
