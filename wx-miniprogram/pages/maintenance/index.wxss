page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 30rpx;
}

.maintenance-card {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.card-header {
    display: flex;
    align-items: center;
    padding: 40rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.card-logo {
    width: 60rpx;
    height: 60rpx;
    margin-right: 20rpx;
}

.card-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #48416f;
}

.maintenance-content {
    padding: 30rpx;
}

/* 维护图标 */
.maintenance-icon-wrapper {
    display: flex;
    justify-content: center;
    padding: 40rpx 0;
}

.maintenance-icon {
    width: 120rpx;
    height: 120rpx;
}

/* 时间显示 */
.time-display {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30rpx;
    background: #f7f8fc;
    border-radius: 20rpx;
    margin: 20rpx 0;
}

.time-text {
    font-size: 48rpx;
    font-weight: bold;
    color: #48416f;
    letter-spacing: 4rpx;
}

.maintenance-section {
    margin-bottom: 40rpx;
}

.maintenance-section:last-child {
    margin-bottom: 0;
}

.section-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 20rpx;
    padding-left: 16rpx;
    border-left: 6rpx solid #13c2c2;
}

.section-text {
    font-size: 26rpx;
    color: #767676;
    line-height: 1.8;
    text-indent: 2em;
}

/* 公告样式 */
.notice-section {
    margin-top: 20rpx;
}

.notice-card {
    background: #f7f8fc;
    border-radius: 16rpx;
    padding: 24rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.notice-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 16rpx;
    padding-bottom: 12rpx;
    border-bottom: 1rpx solid #e0e0e0;
}

.notice-content {
    font-size: 26rpx;
    color: #595959;
    line-height: 1.8;
}

/* 维护内容卡片 - 一行显示2个 */
.feature-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

.feature-item {
    display: flex;
    align-items: center;
    width: 48%;
    padding: 20rpx;
    background: #f7f8fc;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
    margin-bottom: 20rpx;
    box-sizing: border-box;
}

.feature-icon {
    width: 32rpx;
    height: 32rpx;
    margin-right: 12rpx;
    flex-shrink: 0;
}

.feature-item text {
    font-size: 26rpx;
    color: #48416f;
    font-weight: 500;
    flex: 1;
}

.maintenance-footer {
    padding: 30rpx;
    text-align: center;
    border-top: 1rpx solid #f0f0f0;
}

.footer-text {
    font-size: 22rpx;
    color: #948eb3;
}
