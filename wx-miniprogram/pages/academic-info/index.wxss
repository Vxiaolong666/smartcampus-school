page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 40rpx 30rpx;
    padding-bottom: 30rpx;
}

.info-card {
    background: white;
    border-radius: 30rpx;
    padding: 50rpx 40rpx;
    margin-top: 25rpx;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08);
}

.card-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40rpx;
    padding-bottom: 30rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.card-logo {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 20rpx;
}

.card-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #48416f;
}

.loading-wrapper {
    display: flex;
    justify-content: center;
    padding: 100rpx 0;
}

.loading-text {
    font-size: 28rpx;
    color: #948eb3;
}

.empty-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
}

.empty-icon {
    width: 120rpx;
    height: 120rpx;
    opacity: 0.5;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #948eb3;
}

.info-list {
    display: flex;
    flex-direction: column;
}

.info-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28rpx 0;
    border-bottom: 2rpx solid #f7f8fc;
}

.info-item:last-child {
    border-bottom: none;
}

.info-label {
    font-size: 28rpx;
    color: #948eb3;
    flex-shrink: 0;
}

.info-value {
    font-size: 28rpx;
    color: #48416f;
    font-weight: bold;
    text-align: right;
    word-break: break-all;
}

.info-value.status-normal {
    color: #13c2c2;
}

.refresh-btn {
    width: 100%;
    height: 88rpx;
    line-height: 66rpx;
    background: #13c2c2;
    color: #fff;
    font-size: 28rpx;
    border-radius: 20rpx;
    font-weight: bold;
    margin-top: 40rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.refresh-btn:active {
    opacity: 0.9;
}

.refresh-btn .btn-icon {
    width: 32rpx;
    height: 32rpx;
    margin-right: 10rpx;
}
