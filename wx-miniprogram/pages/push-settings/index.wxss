page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 30rpx;
}

.loading-section, .empty-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
}

.empty-icon {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 20rpx;
}

.loading-spinner {
    width: 60rpx;
    height: 60rpx;
    border: 4rpx solid #e0e0e0;
    border-top-color: #13c2c2;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.loading-text, .empty-text {
    margin-top: 20rpx;
    color: #948eb3;
    font-size: 28rpx;
}

.bind-btn {
    margin-top: 30rpx;
    background: linear-gradient(135deg, #13c2c2 0%, #10aeff 100%);
    color: #fff;
    border-radius: 12rpx;
    font-size: 28rpx;
}

.settings-list {
    margin-top: 25rpx;
}

.action-card {
    background: white;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
}

.action-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 20rpx;
    display: flex;
    align-items: center;
}

.action-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 10rpx;
}

.action-desc {
    font-size: 26rpx;
    color: #948eb3;
    line-height: 1.6;
}

.dorm-card {
    background: white;
    border-radius: 20rpx;
    margin-bottom: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.dorm-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.dorm-name {
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    color: #48416f;
}

.dorm-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 10rpx;
}

.default-tag {
    background: linear-gradient(135deg, #13c2c2 0%, #10aeff 100%);
    color: #fff;
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    margin-left: 10rpx;
    font-weight: normal;
}

.dorm-content {
    padding: 30rpx;
}

.form-section {
    margin-bottom: 30rpx;
}

.section-title {
    font-size: 28rpx;
    color: #48416f;
    margin-bottom: 20rpx;
    font-weight: bold;
}

.checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
}

.checkbox-group.vertical {
    flex-direction: column;
    gap: 15rpx;
}

.checkbox-item {
    display: flex;
    align-items: center;
    font-size: 28rpx;
    color: #48416f;
}

.checkbox-item text {
    margin-left: 10rpx;
}

.checkbox-item text.disabled {
    color: #c0c0c0;
}

.input-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx;
    background: #f7f8fc;
    border-radius: 12rpx;
    margin-bottom: 15rpx;
}

.input-label {
    font-size: 28rpx;
    color: #48416f;
}

.input-row input {
    width: 200rpx;
    text-align: right;
    font-size: 28rpx;
    color: #48416f;
}

.save-btn {
    background: linear-gradient(135deg, #13c2c2 0%, #10aeff 100%);
    color: #fff;
    border-radius: 12rpx;
    margin-top: 20rpx;
    font-size: 28rpx;
    box-shadow: 0 10rpx 30rpx rgba(19, 194, 194, 0.3);
}
