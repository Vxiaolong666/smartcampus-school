<view class="container">
  <top-menu showBack="{{true}}">
    <view class="nav-title">修改密码</view>
  </top-menu>

  <view class="background-wrapper">
    <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
    <view class="background-mask"></view>
  </view>

  <view class="content-wrapper">
    <view class="form-card">
      <view class="card-header">
        <image class="card-logo" src="/assets/048-presentation.svg" mode="widthFix"></image>
        <view class="card-title">修改密码</view>
        <view class="card-desc">请输入原密码和新密码</view>
      </view>

      <view class="form-item">
        <view class="form-label">原密码</view>
        <input 
          class="form-input" 
          type="password" 
          placeholder="请输入原密码" 
          value="{{oldPassword}}"
          bindinput="onOldPasswordInput"
        />
      </view>
      
      <view class="form-item">
        <view class="form-label">新密码</view>
        <input 
          class="form-input" 
          type="password" 
          placeholder="请输入新密码（至少6位）" 
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">确认新密码</view>
        <input 
          class="form-input" 
          type="password" 
          placeholder="请再次输入新密码" 
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
      </view>

      <button class="submit-btn" bindtap="onChangePassword" loading="{{loading}}">确认修改</button>
    </view>
  </view>
</view>
