<view class="container">
  <top-menu showBack="{{true}}">
    <view class="nav-title">课程表</view>
  </top-menu>

  <view class="background-wrapper">
    <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
    <view class="background-mask"></view>
  </view>

  <view class="content-wrapper">
    <announcement wx:if="{{announcement}}" content="{{announcement.content}}" type="{{announcement.type}}" closable="{{true}}" />

    <view class="filter-card" wx:if="{{!needBind}}">
      <view class="filter-row">
        <view class="filter-item">
          <view class="filter-label">类别</view>
          <picker mode="selector" range="{{modes}}" range-key="kbjcmsmc" value="{{modeIndex}}" bindchange="onModeChange">
            <view class="filter-value">{{modes[modeIndex].kbjcmsmc || '请选择'}}</view>
          </picker>
        </view>
        <view class="filter-item">
          <view class="filter-label">周次</view>
          <picker mode="selector" range="{{weeks}}" value="{{weekIndex}}" bindchange="onWeekChange">
            <view class="filter-value">{{weeks[weekIndex]}}</view>
          </picker>
        </view>
        <button class="query-btn" bindtap="onQuery" loading="{{loading}}">查询</button>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-wrapper">
      <view class="loading-text">加载中...</view>
    </view>

    <view wx:elif="{{needBind}}" class="empty-wrapper">
      <image class="empty-icon" src="/assets/wxmp-book-gray.svg" mode="widthFix"></image>
      <view class="empty-text">请先绑定教务账号后再查询课程</view>
      <button class="bind-btn" bindtap="goToBind">前往绑定</button>
    </view>

    <view wx:elif="{{schedule.length === 0}}" class="empty-wrapper">
      <image class="empty-icon" src="/assets/wxmp-book-gray.svg" mode="widthFix"></image>
      <view class="empty-text">暂无课程数据</view>
    </view>

    <view wx:else class="schedule-wrapper">
      <view class="schedule-header">
        <view class="header-item">节次</view>
        <view class="header-item" wx:for="{{weekDates}}" wx:key="index" wx:for-index="i">
          <view>{{weekHeaders[i]}}</view>
          <view class="header-date">{{item}}</view>
        </view>
      </view>

      <view class="schedule-body">
        <view class="schedule-row" wx:for="{{schedule}}" wx:key="index" wx:for-index="rowIndex" wx:for-item="row">
          <view class="row-label">
            <view>第{{rowIndex + 1}}节</view>
            <view class="row-time">{{sectionTimes[rowIndex]}}</view>
          </view>
          <view class="row-cells">
            <view 
              class="cell {{cell.hasCourse ? 'has-course' : ''}}" 
              wx:for="{{row}}" 
              wx:key="index" 
              wx:for-item="cell"
              wx:for-index="dayIndex"
              bindtap="onCourseTap"
              data-day="{{dayIndex}}"
              data-section="{{rowIndex}}"
              style="{{cell.hasCourse && cell.color ? 'background-color: ' + cell.color.bg + '; border-left: 4rpx solid ' + cell.color.border : ''}}"
            >
              <block wx:if="{{cell.hasCourse}}">
                <view class="course-name" style="{{cell.color ? 'color: ' + cell.color.text : ''}}">{{cell.courseName}}</view>
                <view class="course-info">{{cell.location}}</view>
              </block>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="course-list" wx:if="{{!loading && courses.length > 0}}">
      <view class="list-title">本周课程详情</view>
      <view 
        class="course-item" 
        wx:for="{{courses}}" 
        wx:key="index"
        data-course="{{item}}"
        bindtap="onCourseItemTap"
      >
        <view class="course-header">
          <view class="course-name">
            <view class="course-color-dot" style="background-color: {{item.color.text}};"></view>
            {{item.courseName}}
          </view>
          <view class="course-time" style="background-color: {{item.color.bg}}; color: {{item.color.text}};">{{item.weekDay}} 第{{item.section}}节</view>
        </view>
        <view class="course-detail">
          <view class="detail-item">
            <text class="detail-label">地点：</text>
            <text class="detail-value">{{item.location || '待定'}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">教师：</text>
            <text class="detail-value">{{item.teacher || '待定'}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">周次：</text>
            <text class="detail-value">{{item.weeks || '-'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- AI 智能分析课表 -->
    <view wx:if="{{!loading && courses.length > 0}}" class="ai-analyze-wrap">
      <view class="ai-analyze-btn {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
        <text wx:if="{{!aiLoading}}">AI 智能分析课表</text>
        <text wx:else>分析中…</text>
      </view>
    </view>
  </view>

  <!-- AI 分析结果浮层 -->
  <view wx:if="{{showAiResult}}" class="ai-mask" bindtap="closeAiResult">
    <view class="ai-modal" style="height: {{sheetHeight}}px" catchtap="noop">
      <view class="ai-modal-handle"></view>
      <view class="ai-modal-header">
        <text class="ai-modal-title">AI 智能课表分析</text>
        <text class="ai-modal-close" catchtap="closeAiResult">✕</text>
      </view>
      <scroll-view scroll-y="true" class="ai-modal-body" catchtap="noop">
        <view class="ai-modal-body-inner">
          <rich-text nodes="{{aiResultHtml}}" class="ai-modal-content"></rich-text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 右侧浮动 AI 分析按钮 -->
  <view class="ai-fab {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
    <text class="ai-fab-icon">AI</text>
    <text class="ai-fab-label">分析</text>
  </view>

  <!-- 课程详情自定义弹窗 -->
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="detail-modal" catchtap="noop">
      <view class="detail-modal-header" style="background: linear-gradient(160deg, {{detailCourse.color.bg}} 0%, #ffffff 100%);">
        <view class="detail-title-wrap">
          <view class="detail-title" style="color: {{detailCourse.color.text}};">{{detailCourse.courseName}}</view>
          <view class="detail-sub">
            <text class="detail-sub-chip" style="background-color: {{detailCourse.color.text}};">{{detailCourse.weekDay}} · 第{{detailCourse.section}}节</text>
          </view>
        </view>
        <view class="detail-close" catchtap="closeDetail">✕</view>
      </view>

      <view class="detail-modal-body">
        <view class="detail-row" wx:if="{{detailCourse.startTime}}">
          <view class="detail-row-icon" style="background-color: {{detailCourse.color.bg}};"><image class="detail-row-icon-img" src="{{detailIcons.time}}" mode="aspectFit" /></view>
          <text class="detail-row-label">上课时段</text>
          <text class="detail-row-value">{{detailCourse.startTime}} - {{detailCourse.endTIme}}</text>
        </view>
        <view class="detail-row">
          <view class="detail-row-icon" style="background-color: {{detailCourse.color.bg}};"><image class="detail-row-icon-img" src="{{detailIcons.location}}" mode="aspectFit" /></view>
          <text class="detail-row-label">上课地点</text>
          <text class="detail-row-value">{{detailCourse.location || '待定'}}</text>
        </view>
        <view class="detail-row">
          <view class="detail-row-icon" style="background-color: {{detailCourse.color.bg}};"><image class="detail-row-icon-img" src="{{detailIcons.user}}" mode="aspectFit" /></view>
          <text class="detail-row-label">授课教师</text>
          <text class="detail-row-value">{{detailCourse.teacher || '待定'}}</text>
        </view>
        <view class="detail-row">
          <view class="detail-row-icon" style="background-color: {{detailCourse.color.bg}};"><image class="detail-row-icon-img" src="{{detailIcons.calendar}}" mode="aspectFit" /></view>
          <text class="detail-row-label">上课周次</text>
          <text class="detail-row-value">{{detailCourse.weeks || '-'}}</text>
        </view>

        <view class="detail-grid" wx:if="{{detailCourse.credit || detailCourse.courseNature}}">
          <view class="detail-grid-item" wx:if="{{detailCourse.credit}}">
            <view class="detail-grid-num">{{detailCourse.credit}}</view>
            <view class="detail-grid-label">学分</view>
          </view>
          <view class="detail-grid-item" wx:if="{{detailCourse.courseNature}}">
            <view class="detail-grid-num">{{detailCourse.courseNature}}</view>
            <view class="detail-grid-label">课程性质</view>
          </view>
        </view>

        <button class="detail-btn" catchtap="closeDetail" style="background: linear-gradient(90deg, {{detailCourse.color.text}}, {{detailBtnBgLight}}); box-shadow: 0 10rpx 24rpx {{detailBtnShadow}};">我知道了</button>
      </view>
    </view>
  </view>
</view>
