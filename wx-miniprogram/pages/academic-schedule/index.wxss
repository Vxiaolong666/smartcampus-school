page {
    background: #eff1ff;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 30rpx;
}

.filter-card {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx 30rpx;
    margin-top: 25rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.filter-row {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.filter-item {
    flex: 1;
}

.filter-label {
    font-size: 24rpx;
    color: #948eb3;
    margin-bottom: 8rpx;
}

.filter-value {
    font-size: 28rpx;
    color: #48416f;
    background: #f7f8fc;
    padding: 16rpx 20rpx;
    border-radius: 12rpx;
}

.query-btn {
    background: #13c2c2;
    color: white;
    font-size: 28rpx;
    padding: 0 30rpx;
    height: 72rpx;
    line-height: 72rpx;
    border-radius: 12rpx;
    margin: 0;
}

.loading-wrapper {
    display: flex;
    justify-content: center;
    padding: 100rpx 0;
}

.loading-text {
    font-size: 28rpx;
    color: #948eb3;
}

.empty-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
}

.empty-icon {
    width: 120rpx;
    height: 120rpx;
    opacity: 0.5;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #948eb3;
}

.schedule-wrapper {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.schedule-header {
    display: flex;
    background: #13c2c2;
}

.header-item {
    flex: 1;
    text-align: center;
    color: white;
    font-size: 22rpx;
    padding: 16rpx 0;
    font-weight: bold;
}

.header-item:first-child {
    flex: 0 0 80rpx;
}

.schedule-body {
    display: flex;
    flex-direction: column;
}

.schedule-row {
    display: flex;
    border-bottom: 2rpx solid #f0f0f0;
}

.schedule-row:last-child {
    border-bottom: none;
}

.row-label {
    width: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20rpx;
    color: #948eb3;
    background: #f7f8fc;
}

.row-cells {
    flex: 1;
    display: flex;
}

.cell {
    flex: 1;
    min-height: 80rpx;
    border-right: 2rpx solid #f0f0f0;
    padding: 8rpx;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.cell:last-child {
    border-right: none;
}

.cell.has-course {
    background: #e8f9f9;
    border-left: 4rpx solid #13c2c2;
}

.cell.has-course:active {
    opacity: 0.8;
}

.course-name {
    font-size: 18rpx;
    color: #48416f;
    text-align: center;
    word-break: break-all;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
}

.course-color-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    margin-right: 8rpx;
    flex-shrink: 0;
}

.course-info {
    font-size: 16rpx;
    color: #948eb3;
    text-align: center;
    margin-top: 4rpx;
}

.course-list {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.list-title {
    font-size: 28rpx;
    color: #48416f;
    font-weight: bold;
    margin-bottom: 20rpx;
}

.course-item {
    padding: 24rpx 0;
    border-bottom: 2rpx solid #f0f0f0;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.course-item:active {
    background-color: #f5f5f5;
}

.course-item:last-child {
    border-bottom: none;
}

.course-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
}

.course-header .course-name {
    font-size: 30rpx;
    color: #48416f;
    font-weight: bold;
    display: flex;
    align-items: center;
}

.course-header .course-color-dot {
    width: 16rpx;
    height: 16rpx;
    border-radius: 50%;
    margin-right: 12rpx;
    flex-shrink: 0;
}

.course-name {
    font-size: 30rpx;
    color: #48416f;
    font-weight: bold;
}

.course-time {
    font-size: 24rpx;
    color: #13c2c2;
    background: #e8f9f9;
    padding: 8rpx 16rpx;
    border-radius: 8rpx;
}

.course-detail {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.detail-item {
    font-size: 24rpx;
}

.detail-label {
    color: #948eb3;
}

.detail-value {
    color: #48416f;
}
