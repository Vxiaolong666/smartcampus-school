page {
    background: #eff1ff;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
}

.nav-title {
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
    color: white;
    letter-spacing: 6rpx;
}

.nav-action {
    padding: 0 30rpx;
}

.action-text {
    font-size: 26rpx;
    color: white;
}

.background-wrapper {
    position: fixed;
    width: 100%;
    top: 0;
}

.background {
    width: 100%;
    position: absolute;
    top: 0;
    height: 800rpx;
}

.background-mask {
    background-image: linear-gradient(rgba(0, 0, 0, .8), transparent);
    height: 600rpx;
    position: absolute;
    width: 100%;
    top: 0;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    background: #eff1ff;
    top: 30rpx;
    min-height: calc(100vh - 200rpx);
    border-top-left-radius: 60rpx;
    border-top-right-radius: 60rpx;
    box-shadow: 0 -80rpx 80rpx 40rpx rgba(0, 0, 0, .2);
    padding: 30rpx;
    padding-bottom: 100rpx;
}

.day-selector {
    display: flex;
    justify-content: space-between;
    background: white;
    border-radius: 20rpx;
    padding: 20rpx 10rpx;
    margin-top: 25rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.day-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16rpx 0;
    border-radius: 16rpx;
    transition: all 0.3s;
    position: relative;
}

.day-item.active {
    background: #13c2c2;
}

.day-item.active .day-name,
.day-item.active .day-date,
.day-item.active .day-tag {
    color: white;
}

.day-item.today:not(.active) .day-tag {
    color: #13c2c2;
}

.day-name {
    font-size: 22rpx;
    color: #948eb3;
    margin-bottom: 4rpx;
}

.day-date {
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
}

.day-tag {
    font-size: 18rpx;
    color: #948eb3;
    margin-top: 2rpx;
}

.info-cards {
    display: flex;
    gap: 20rpx;
    margin-bottom: 24rpx;
}

.info-card {
    flex: 1;
    background: white;
    border-radius: 20rpx;
    padding: 24rpx;
    display: flex;
    align-items: center;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.info-icon {
    width: 48rpx;
    height: 48rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.info-content {
    flex: 1;
}

.info-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 8rpx;
}

.info-sub {
    font-size: 24rpx;
    color: #948eb3;
}

.status-current {
    color: #52c41a;
}

.status-free {
    color: #948eb3;
}

.status-ended {
    color: #52c41a;
}

.status-ending {
    color: #faad14;
}

.status-waiting {
    color: #1890ff;
}

.status-cards {
    display: flex;
    gap: 20rpx;
    margin-bottom: 24rpx;
}

.status-card {
    flex: 1;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
    background: white;
}

.status-card.current {
    border: 2rpx solid;
}

.status-card.next {
    border: 2rpx solid;
}

.status-card.ended {
    border: 2rpx solid #52c41a;
}

.status-card.waiting {
    border: 2rpx solid;
}

.status-header {
    padding: 20rpx 24rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.status-card.ended .status-header {
    background: #52c41a;
}

.status-card.waiting .status-header {
    background: #1890ff;
}

.status-label {
    font-size: 26rpx;
    font-weight: bold;
    color: white;
    display: flex;
    align-items: center;
}

.status-label-icon {
    width: 24rpx;
    height: 24rpx;
    margin-right: 8rpx;
}

.status-label-icon.large {
    width: 32rpx;
    height: 32rpx;
    margin-right: 12rpx;
}

.status-time {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
}

.status-body {
    background: white;
    padding: 24rpx;
}

.status-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 12rpx;
}

.status-info-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.status-info-item {
    font-size: 24rpx;
    color: #666666;
    display: flex;
    align-items: center;
}

.status-info:last-child {
    margin-bottom: 0;
}

.status-icon {
    width: 24rpx;
    height: 24rpx;
    margin-right: 8rpx;
    flex-shrink: 0;
}

.loading-wrapper {
    display: flex;
    justify-content: center;
    padding: 100rpx 0;
}

.loading-text {
    font-size: 28rpx;
    color: #948eb3;
}

.course-list-wrapper {
    display: flex;
    flex-direction: column;
    gap: 24rpx;
}

.course-section {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.section-title {
    display: flex;
    align-items: center;
    font-size: 30rpx;
    font-weight: bold;
    color: #48416f;
}

.section-icon {
    width: 32rpx;
    height: 32rpx;
    margin-right: 12rpx;
}

.section-count {
    font-size: 24rpx;
    color: #13c2c2;
    background: #e8f9f9;
    padding: 8rpx 16rpx;
    border-radius: 8rpx;
}

.course-timeline {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.course-card-wrapper {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
}

.course-card-wrapper.ended .course-card {
    opacity: 0.6;
}

.course-card-wrapper.ended .course-time {
    color: #999999;
}

.course-card-wrapper.ended .course-info-item {
    color: #999999;
}

.timeline-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 40rpx;
    flex-shrink: 0;
    margin-right: 16rpx;
}

.timeline-dot {
    width: 16rpx;
    height: 16rpx;
    border-radius: 50%;
    flex-shrink: 0;
    margin: 24rpx 0;
    box-shadow: 0 0 0 4rpx rgba(0, 0, 0, 0.05);
}

.timeline-line-top,
.timeline-line-bottom {
    flex: 1;
    width: 2rpx;
    background: linear-gradient(to bottom, #e0e0e0, #d0d0d0);
}

.course-card {
    flex: 1;
    min-width: 0;
    background: white;
    border-radius: 16rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
}

.course-card:active {
    transform: scale(0.99);
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.course-content {
    padding: 20rpx 24rpx;
}

.course-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.course-slot {
    font-size: 22rpx;
    font-weight: bold;
}

.course-time {
    font-size: 20rpx;
    color: #948eb3;
}

.course-name-row {
    display: flex;
    align-items: center;
    margin-bottom: 8rpx;
}

.course-icon-book {
    width: 24rpx;
    height: 24rpx;
    margin-right: 10rpx;
    flex-shrink: 0;
    border-radius: 6rpx;
    position: relative;
    background: currentColor;
}

.course-icon-book::before {
    content: '';
    position: absolute;
    left: 6rpx;
    top: 4rpx;
    width: 2rpx;
    height: 16rpx;
    background: rgba(255, 255, 255, 0.6);
}

.course-icon-book::after {
    content: '';
    position: absolute;
    left: 10rpx;
    top: 6rpx;
    width: 2rpx;
    height: 12rpx;
    background: rgba(255, 255, 255, 0.4);
}

.course-name {
    flex: 1;
    min-width: 0;
    font-size: 28rpx;
    font-weight: bold;
    color: #48416f;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.course-info-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.course-info-item {
    font-size: 22rpx;
    color: #666666;
    display: flex;
    align-items: center;
}

.course-icon {
    width: 20rpx;
    height: 20rpx;
    margin-right: 6rpx;
    flex-shrink: 0;
}

.empty-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 80rpx 0;
}

.empty-icon {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 20rpx;
}

.empty-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #48416f;
    margin-bottom: 12rpx;
}

.empty-text {
    font-size: 26rpx;
    color: #948eb3;
}

/* ==================== 课程详情自定义弹窗 ==================== */

.detail-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(50, 44, 84, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60rpx;
    animation: detailMaskFade 0.25s ease;
}

@keyframes detailMaskFade {
    from { opacity: 0; }
    to { opacity: 1; }
}

.detail-modal {
    width: 100%;
    max-width: 620rpx;
    background: white;
    border-radius: 32rpx;
    overflow: hidden;
    box-shadow: 0 24rpx 80rpx rgba(50, 44, 84, 0.25);
    animation: detailModalUp 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes detailModalUp {
    from { transform: translateY(80rpx) scale(0.96); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
}

.detail-modal-header {
    display: flex;
    align-items: flex-start;
    padding: 36rpx 32rpx 28rpx;
}

.detail-title-wrap {
    flex: 1;
    min-width: 0;
}

.detail-title {
    font-size: 36rpx;
    font-weight: bold;
    line-height: 1.35;
    word-break: break-all;
    letter-spacing: 1rpx;
}

.detail-sub {
    margin-top: 16rpx;
}

.detail-sub-chip {
    display: inline-block;
    font-size: 22rpx;
    color: white;
    padding: 8rpx 22rpx;
    border-radius: 999rpx;
    letter-spacing: 1rpx;
}

.detail-close {
    width: 52rpx;
    height: 52rpx;
    line-height: 50rpx;
    text-align: center;
    font-size: 26rpx;
    color: #948eb3;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    flex-shrink: 0;
    margin-left: 16rpx;
    box-shadow: 0 4rpx 12rpx rgba(50, 44, 84, 0.08);
}

.detail-close:active {
    background: #f0eef6;
    transform: scale(0.92);
}

.detail-modal-body {
    padding: 8rpx 36rpx 40rpx;
}

.detail-row {
    display: flex;
    align-items: center;
    padding: 22rpx 0;
}

.detail-row-icon {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    margin-right: 22rpx;
    flex-shrink: 0;
}

.detail-row-icon-img {
    width: 32rpx;
    height: 32rpx;
}

.detail-row-label {
    font-size: 26rpx;
    color: #948eb3;
    width: 150rpx;
    flex-shrink: 0;
}

.detail-row-value {
    flex: 1;
    font-size: 27rpx;
    color: #48416f;
    font-weight: 500;
    text-align: right;
    word-break: break-all;
    line-height: 1.5;
}

.detail-btn {
    margin-top: 36rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 42rpx;
    color: white;
    font-size: 30rpx;
    font-weight: bold;
    letter-spacing: 4rpx;
    padding: 0;
}

.detail-btn:active {
    opacity: 0.85;
    transform: scale(0.98);
}

.detail-btn::after {
    border: none;
}
