<view class="container">
  <top-menu showBack="{{false}}">
    <view class="nav-title">今日课程</view>
    <view slot="right" class="nav-action" bindtap="goToFullSchedule">
      <text class="action-text">完整课表</text>
    </view>
  </top-menu>

  <view class="background-wrapper">
    <image class="background" src="/assets/wxmp-banner.jpg" mode="aspectFill" />
    <view class="background-mask"></view>
  </view>

  <view class="content-wrapper">
    <view wx:if="{{announcement}}">
      <announcement content="{{announcement.content}}" type="{{announcement.type}}" closable="{{true}}" />
    </view>

    <view class="day-selector" wx:if="{{!loading && !needBind}}">
      <view 
        class="day-item {{selectedDay === index ? 'active' : ''}} {{todayDayOfWeek === index ? 'today' : ''}}" 
        wx:for="{{weekDates}}" 
        wx:key="dateStr"
        data-day="{{index}}"
        bindtap="onDaySelect"
      >
        <view class="day-name">{{['周日','周一','周二','周三','周四','周五','周六'][index]}}</view>
        <view class="day-date">{{item.date}}</view>
        <view class="day-tag" wx:if="{{todayDayOfWeek === index}}">今天</view>
      </view>
    </view>

    <view class="info-cards" wx:if="{{!loading && !needBind}}">
      <view class="info-card date-card">
        <image class="info-icon" src="/assets/wxmp-calendar.svg" mode="widthFix"></image>
        <view class="info-content">
          <view class="info-title">{{['星期日','星期一','星期二','星期三','星期四','星期五','星期六'][selectedDay]}}{{selectedDay === todayDayOfWeek ? ' (今天)' : ''}}</view>
          <view class="info-sub">{{weekDates[selectedDay].full}} · 第{{currentWeek}}周</view>
        </view>
      </view>
      <view class="info-card time-card">
        <image class="info-icon" src="/assets/wxmp-clock.svg" mode="widthFix"></image>
        <view class="info-content">
          <view class="info-title">
            {{currentTime}}
          </view>
          <view class="info-sub">
            <block wx:if="{{selectedDay !== todayDayOfWeek}}">
              <text class="status-free">非今日</text>
            </block>
            <block wx:elif="{{allCoursesEnded}}">
              <text class="status-ended">今日课程结束了</text>
            </block>
            <block wx:elif="{{isEndingSoon}}">
              <text class="status-ending">即将下课</text>
            </block>
            <block wx:elif="{{currentCourse}}">
              <text class="status-current">上课中</text>
            </block>
            <block wx:elif="{{notStarted || inBreak}}">
              <text class="status-waiting">即将上课</text>
            </block>
            <block wx:else>
              <text class="status-free">课余时间</text>
            </block>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{currentCourse || nextCourse || allCoursesEnded || notStarted}}" class="status-cards">
      <view wx:if="{{allCoursesEnded && selectedDay === todayDayOfWeek}}" class="status-card ended">
        <view class="status-header">
          <image class="status-label-icon" src="/assets/wxmp-check.svg" mode="widthFix"></image>
          <text class="status-label">今日课程已结束</text>
        </view>
        <view class="status-body">
          <view class="status-title">今日的课上完了，好好休息吧~</view>
        </view>
      </view>

      <view wx:if="{{notStarted && selectedDay === todayDayOfWeek && nextCourse}}" class="status-card waiting" style="border-color: {{nextCourse.color.text}};">
        <view class="status-header" style="background-color: {{nextCourse.color.text}};">
          <image class="status-label-icon large" src="/assets/wxmp-alarm-white.svg" mode="widthFix"></image>
          <text class="status-label">课程未开始</text>
          <text class="status-time">还有{{minutesToNext}}分钟上课</text>
        </view>
        <view class="status-body" style="background: linear-gradient(135deg, {{nextCourse.color.bg}} 0%, #ffffff 100%);">
          <view class="status-title" style="color: {{nextCourse.color.text}};">{{nextCourse.courseName}}</view>
          <view class="status-info-row" wx:if="{{nextCourse.location || nextCourse.teacher}}">
            <view class="status-info-item" wx:if="{{nextCourse.location}}">
              <image class="status-icon" src="/assets/wxmp-location.svg" mode="widthFix"></image>
              <text>{{nextCourse.location}}</text>
            </view>
            <view class="status-info-item" wx:if="{{nextCourse.teacher}}">
              <image class="status-icon" src="/assets/wxmp-user.svg" mode="widthFix"></image>
              <text>{{nextCourse.teacher}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{currentCourse && selectedDay === todayDayOfWeek}}" class="status-card current" style="border-color: {{currentCourse.color.text}};">
        <view class="status-header" style="background-color: {{currentCourse.color.text}};">
          <image class="status-label-icon large" src="/assets/wxmp-play-white.svg" mode="widthFix"></image>
          <text class="status-label">正在上课</text>
          <text class="status-time">还有{{minutesToEnd}}分钟下课</text>
        </view>
        <view class="status-body" style="background: linear-gradient(135deg, {{currentCourse.color.bg}} 0%, #ffffff 100%);">
          <view class="status-title" style="color: {{currentCourse.color.text}};">{{currentCourse.courseName}}</view>
          <view class="status-info-row" wx:if="{{currentCourse.location || currentCourse.teacher}}">
            <view class="status-info-item" wx:if="{{currentCourse.location}}">
              <image class="status-icon" src="/assets/wxmp-location.svg" mode="widthFix"></image>
              <text>{{currentCourse.location}}</text>
            </view>
            <view class="status-info-item" wx:if="{{currentCourse.teacher}}">
              <image class="status-icon" src="/assets/wxmp-user.svg" mode="widthFix"></image>
              <text>{{currentCourse.teacher}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{inBreak && nextCourse && selectedDay === todayDayOfWeek}}" class="status-card next" style="border-color: {{nextCourse.color.text}};">
        <view class="status-header" style="background-color: {{nextCourse.color.text}};">
          <image class="status-label-icon large" src="/assets/wxmp-alarm-white.svg" mode="widthFix"></image>
          <text class="status-label">课间休息</text>
          <text class="status-time">还有{{minutesToNext}}分钟上课</text>
        </view>
        <view class="status-body" style="background: linear-gradient(135deg, {{nextCourse.color.bg}} 0%, #ffffff 100%);">
          <view class="status-title" style="color: {{nextCourse.color.text}};">{{nextCourse.courseName}}</view>
          <view class="status-info-row" wx:if="{{nextCourse.location || nextCourse.teacher}}">
            <view class="status-info-item" wx:if="{{nextCourse.location}}">
              <image class="status-icon" src="/assets/wxmp-location.svg" mode="widthFix"></image>
              <text>{{nextCourse.location}}</text>
            </view>
            <view class="status-info-item" wx:if="{{nextCourse.teacher}}">
              <image class="status-icon" src="/assets/wxmp-user.svg" mode="widthFix"></image>
              <text>{{nextCourse.teacher}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <cb-load-fail />
    <cb-loading wx:if="{{loading}}" />

    <view wx:elif="{{dayCourses.length > 0}}" class="course-list-wrapper">
      <view wx:if="{{morningCourses.length > 0}}" class="course-section">
        <view class="section-header">
          <view class="section-title">
            <image class="section-icon" src="/assets/wxmp-sun.svg" mode="widthFix"></image>
            <text>上午</text>
          </view>
          <text class="section-count">{{morningCourses.length}}节</text>
        </view>
        <view class="course-timeline">
          <view 
            class="course-card-wrapper {{currentCourse && currentCourse.courseName === item.courseName ? 'current' : ''}} {{item.isEnded ? 'ended' : ''}}" 
            wx:for="{{morningCourses}}" 
            wx:key="classTime"
            data-course="{{item}}"
            bindtap="onCourseTap"
          >
            <view class="timeline-left">
              <view class="timeline-line-top" wx:if="{{index > 0}}"></view>
              <view class="timeline-dot" style="background-color: {{item.isEnded ? '#cccccc' : item.color.text}};"></view>
              <view class="timeline-line-bottom" wx:if="{{index < morningCourses.length - 1}}"></view>
            </view>
            <view class="course-card" style="{{currentCourse && currentCourse.courseName === item.courseName ? 'border: 2rpx solid ' + item.color.text : ''}}">
              <view class="course-content">
                <view class="course-header">
                  <view class="course-slot" style="color: {{item.isEnded ? '#999999' : item.color.text}};">
                    第{{item.slots[0]}}节
                  </view>
                  <view class="course-time">{{item.timeDisplay}}</view>
                </view>
                <view class="course-name-row">
                  <view class="course-icon-book" style="color: {{item.isEnded ? '#999999' : item.color.text}};"></view>
                  <text class="course-name" style="color: {{item.isEnded ? '#999999' : item.color.text}};">{{item.courseName}}</text>
                </view>
                <view class="course-info-row" wx:if="{{item.location || item.teacher}}">
                  <view class="course-info-item" wx:if="{{item.location}}">
                    <image class="course-icon" src="/assets/wxmp-location.svg" mode="widthFix"></image>
                    <text>{{item.location}}</text>
                  </view>
                  <view class="course-info-item" wx:if="{{item.teacher}}">
                    <image class="course-icon" src="/assets/wxmp-user.svg" mode="widthFix"></image>
                    <text>{{item.teacher}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{afternoonCourses.length > 0}}" class="course-section">
        <view class="section-header">
          <view class="section-title">
            <image class="section-icon" src="/assets/wxmp-cloud.svg" mode="widthFix"></image>
            <text>下午</text>
          </view>
          <text class="section-count">{{afternoonCourses.length}}节</text>
        </view>
        <view class="course-timeline">
          <view 
            class="course-card-wrapper {{currentCourse && currentCourse.courseName === item.courseName ? 'current' : ''}} {{item.isEnded ? 'ended' : ''}}" 
            wx:for="{{afternoonCourses}}" 
            wx:key="classTime"
            data-course="{{item}}"
            bindtap="onCourseTap"
          >
            <view class="timeline-left">
              <view class="timeline-line-top" wx:if="{{index > 0}}"></view>
              <view class="timeline-dot" style="background-color: {{item.isEnded ? '#cccccc' : item.color.text}};"></view>
              <view class="timeline-line-bottom" wx:if="{{index < afternoonCourses.length - 1}}"></view>
            </view>
            <view class="course-card" style="{{currentCourse && currentCourse.courseName === item.courseName ? 'border: 2rpx solid ' + item.color.text : ''}}">
              <view class="course-content">
                <view class="course-header">
                  <view class="course-slot" style="color: {{item.isEnded ? '#999999' : item.color.text}};">
                    第{{item.slots[0]}}节
                  </view>
                  <view class="course-time">{{item.timeDisplay}}</view>
                </view>
                <view class="course-name-row">
                  <view class="course-icon-book" style="color: {{item.isEnded ? '#999999' : item.color.text}};"></view>
                  <text class="course-name" style="color: {{item.isEnded ? '#999999' : item.color.text}};">{{item.courseName}}</text>
                </view>
                <view class="course-info-row" wx:if="{{item.location || item.teacher}}">
                  <view class="course-info-item" wx:if="{{item.location}}">
                    <image class="course-icon" src="/assets/wxmp-location.svg" mode="widthFix"></image>
                    <text>{{item.location}}</text>
                  </view>
                  <view class="course-info-item" wx:if="{{item.teacher}}">
                    <image class="course-icon" src="/assets/wxmp-user.svg" mode="widthFix"></image>
                    <text>{{item.teacher}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{eveningCourses.length > 0}}" class="course-section">
        <view class="section-header">
          <view class="section-title">
            <image class="section-icon" src="/assets/wxmp-moon.svg" mode="widthFix"></image>
            <text>晚上</text>
          </view>
          <text class="section-count">{{eveningCourses.length}}节</text>
        </view>
        <view class="course-timeline">
          <view 
            class="course-card-wrapper {{currentCourse && currentCourse.courseName === item.courseName ? 'current' : ''}} {{item.isEnded ? 'ended' : ''}}" 
            wx:for="{{eveningCourses}}" 
            wx:key="classTime"
            data-course="{{item}}"
            bindtap="onCourseTap"
          >
            <view class="timeline-left">
              <view class="timeline-line-top" wx:if="{{index > 0}}"></view>
              <view class="timeline-dot" style="background-color: {{item.isEnded ? '#cccccc' : item.color.text}};"></view>
              <view class="timeline-line-bottom" wx:if="{{index < eveningCourses.length - 1}}"></view>
            </view>
            <view class="course-card" style="{{currentCourse && currentCourse.courseName === item.courseName ? 'border: 2rpx solid ' + item.color.text : ''}}">
              <view class="course-content">
                <view class="course-header">
                  <view class="course-slot" style="color: {{item.isEnded ? '#999999' : item.color.text}};">
                    第{{item.slots[0]}}节
                  </view>
                  <view class="course-time">{{item.timeDisplay}}</view>
                </view>
                <view class="course-name-row">
                  <view class="course-icon-book" style="color: {{item.isEnded ? '#999999' : item.color.text}};"></view>
                  <text class="course-name" style="color: {{item.isEnded ? '#999999' : item.color.text}};">{{item.courseName}}</text>
                </view>
                <view class="course-info-row" wx:if="{{item.location || item.teacher}}">
                  <view class="course-info-item" wx:if="{{item.location}}">
                    <image class="course-icon" src="/assets/wxmp-location.svg" mode="widthFix"></image>
                    <text>{{item.location}}</text>
                  </view>
                  <view class="course-info-item" wx:if="{{item.teacher}}">
                    <image class="course-icon" src="/assets/wxmp-user.svg" mode="widthFix"></image>
                    <text>{{item.teacher}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <cb-bind-tip wx:elif="{{needBind}}" type="academic" desc="绑定后可查看今日与本周课程安排" />

    <view wx:else class="empty-wrapper">
      <image class="empty-icon" src="/assets/wxmp-book-gray.svg" mode="widthFix"></image>
      <view class="empty-title">{{['星期日','星期一','星期二','星期三','星期四','星期五','星期六'][selectedDay]}}没有课程</view>
      <view class="empty-text">
        {{selectedDay === todayDayOfWeek ? '今天没有课程，好好休息一下吧~' : '这一天没有安排课程，看看其他天吧~'}}
      </view>
    </view>

    <!-- AI 智能分析今日安排 -->
    <view wx:if="{{!loading && dayCourses.length > 0}}" class="ai-analyze-wrap">
      <view class="ai-analyze-btn {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
        <text wx:if="{{!aiLoading}}">AI 智能分析今日安排</text>
        <text wx:else>分析中…</text>
      </view>
    </view>
  </view>

  <!-- AI 分析结果浮层 -->
  <view wx:if="{{showAiResult}}" class="ai-mask" bindtap="closeAiResult">
    <view class="ai-modal" style="height: {{sheetHeight}}px" catchtap="noop">
      <view class="ai-modal-handle"></view>
      <view class="ai-modal-header">
        <view class="ai-modal-title-wrap">
          <text class="ai-modal-badge">AI</text>
          <text class="ai-modal-title">智能日程分析</text>
        </view>
        <text class="ai-modal-close" catchtap="closeAiResult">✕</text>
      </view>
      <!-- 正在分析：复用全站统一的圆环 loading，垂直居中 -->
      <view wx:if="{{aiLoading}}" class="ai-modal-center-body">
        <cb-loading class="ai-modal-center-item" compact="{{true}}" large="{{true}}" text="AI 正在分析…"
          subTexts="{{['读取今日课程，约需十几秒', '正在梳理今日安排…', '正在撰写日程建议…', '马上就好，请稍候…']}}"
          slowAfter="{{16000}}" slowText="分析时间有点久…" slowSubText="可稍候，或关闭后重新分析" />
      </view>
      <view wx:elif="{{aiError}}" class="ai-modal-center-body">
        <!-- 分析失败：复用全站统一的网络异常样式，垂直居中 -->
        <view class="ai-error ai-modal-center-item">
          <image class="ai-error-icon" src="/assets/wxmp-network-error.svg" mode="widthFix"></image>
          <view class="ai-error-title">分析失败</view>
          <view class="ai-error-desc">{{aiError}}</view>
          <view class="ai-error-btn" catchtap="aiAnalyze">重新分析</view>
        </view>
      </view>
      <scroll-view wx:else scroll-y="true" class="ai-modal-body" catchtap="noop">
        <view class="ai-modal-body-inner">
          <!-- 分析结果 -->
          <rich-text nodes="{{aiResultHtml}}" class="ai-modal-content"></rich-text>
          <view class="ai-result-foot">内容由 AI 生成，仅供参考</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 右侧浮动 AI 分析按钮（tabBar 页面抬高避免被标签栏遮挡） -->
  <view wx:if="{{!loading && !needBind && dayCourses.length > 0}}" class="ai-fab ai-fab--tab {{aiLoading ? 'ai-loading' : ''}}" bindtap="aiAnalyze">
    <text class="ai-fab-icon">AI</text>
    <text class="ai-fab-label">分析</text>
  </view>

  <!-- 课程详情自定义弹窗 -->
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="detail-modal" catchtap="noop">
      <view class="detail-modal-header" style="background: linear-gradient(160deg, {{detailCourse.color.bg}} 0%, #ffffff 100%);">
        <view class="detail-title-wrap">
          <view class="detail-title" style="color: {{detailCourse.color.text}};">{{detailCourse.courseName}}</view>
          <view class="detail-sub">
            <text class="detail-sub-chip" style="background-color: {{detailCourse.color.text}};">{{detailCourse.weekDayName}} · 第{{detailCourse.slots[0]}}节</text>
          </view>
        </view>
        <view class="detail-close" catchtap="closeDetail">✕</view>
      </view>

      <view class="detail-modal-body">
        <view class="detail-row" wx:if="{{detailCourse.timeDisplay}}">
          <view class="detail-row-icon" style="background-color: {{detailCourse.color.bg}};"><image class="detail-row-icon-img" src="{{detailIcons.time}}" mode="aspectFit" /></view>
          <text class="detail-row-label">上课时段</text>
          <text class="detail-row-value">{{detailCourse.timeDisplay}}</text>
        </view>
        <view class="detail-row">
          <view class="detail-row-icon" style="background-color: {{detailCourse.color.bg}};"><image class="detail-row-icon-img" src="{{detailIcons.location}}" mode="aspectFit" /></view>
          <text class="detail-row-label">上课地点</text>
          <text class="detail-row-value">{{detailCourse.location || '待定'}}</text>
        </view>
        <view class="detail-row">
          <view class="detail-row-icon" style="background-color: {{detailCourse.color.bg}};"><image class="detail-row-icon-img" src="{{detailIcons.user}}" mode="aspectFit" /></view>
          <text class="detail-row-label">授课教师</text>
          <text class="detail-row-value">{{detailCourse.teacher || '待定'}}</text>
        </view>
        <view class="detail-row">
          <view class="detail-row-icon" style="background-color: {{detailCourse.color.bg}};"><image class="detail-row-icon-img" src="{{detailIcons.calendar}}" mode="aspectFit" /></view>
          <text class="detail-row-label">上课周次</text>
          <text class="detail-row-value">{{detailCourse.weeks || '-'}}</text>
        </view>

        <button class="detail-btn" catchtap="closeDetail" style="background: linear-gradient(90deg, {{detailCourse.color.text}}, {{detailBtnBgLight}}); box-shadow: 0 10rpx 24rpx {{detailBtnShadow}};">我知道了</button>
      </view>
    </view>
  </view>
</view>
