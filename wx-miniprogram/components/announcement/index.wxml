
<view wx:if="{{visible}}" class="announcement {{typeClass}}">
  <image class="announcement-icon" src="{{icon}}" mode="aspectFit"></image>
  <view class="announcement-content" bindtap="onTap">{{content}}</view>
  <view wx:if="{{closable}}" class="announcement-close" bindtap="onClose">
    <text>×</text>
  </view>
</view>

<contact-guide id="contactGuide" />

