/* 联系客服弹窗样式：1:1 复刻 uniapp contact-modal */

.cg-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 60rpx;
}

.cg-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(50, 44, 84, 0.22);
}

.cg-header {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 36rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.cg-title {
  max-width: 100%;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  letter-spacing: 2rpx;
  text-align: center;
}

.cg-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #98a2b3;
  letter-spacing: 1rpx;
}

.cg-close {
  position: absolute;
  right: 36rpx;
  top: 36rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: #999999;
  background: #f4f5fb;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(50, 44, 84, 0.12);
}

.cg-body {
  padding: 28rpx 36rpx 8rpx;
  box-sizing: border-box;
  white-space: normal;
}

.cg-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 16rpx;
  margin: 0 0 20rpx;
  padding: 0;
  box-sizing: border-box;
}

.cg-btn::after {
  border: none;
}

.cg-btn-primary {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #13c2c2 0%, #1890ff 100%);
}

.cg-btn-ghost {
  color: #948eb3;
  background: #f4f5fb;
}

.cg-loading {
  text-align: center;
  font-size: 26rpx;
  color: #948eb3;
  padding: 40rpx 0;
}

.cg-item-wrap {
  width: 100%;
}

.cg-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f7;
  white-space: normal;
}

.cg-item-wrap:last-child .cg-item {
  border-bottom: none;
}

.cg-item.cg-item-plain {
  border-bottom: none;
}

.cg-item-label {
  flex-shrink: 0;
  min-width: 116rpx;
  max-width: 180rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
  padding: 6rpx 16rpx;
  margin-right: 20rpx;
  margin-top: 2rpx;
  font-size: 24rpx;
  border-radius: 10rpx;
  background: rgba(24, 144, 255, 0.12);
  color: #1890ff;
}

.cg-item-label.is-phone {
  background: rgba(24, 144, 255, 0.12);
  color: #1890ff;
}

.cg-item-label.is-mail {
  background: rgba(114, 46, 209, 0.12);
  color: #722ed1;
}

.cg-item-label.is-qq {
  background: rgba(19, 194, 194, 0.12);
  color: #13c2c2;
}

.cg-item-label.is-wechat {
  background: rgba(82, 196, 26, 0.12);
  color: #52c41a;
}

.cg-item-label.is-time {
  background: rgba(250, 140, 22, 0.12);
  color: #fa8c16;
}

.cg-item-label.is-address {
  background: rgba(235, 47, 150, 0.12);
  color: #eb2f96;
}

.cg-item-label.is-desc {
  background: rgba(140, 140, 140, 0.12);
  color: #8c8c8c;
}

.cg-item-value {
  flex: 1 1 auto;
  width: 0;
  min-width: 0;
  font-size: 29rpx;
  color: #333333;
  line-height: 1.6;
  white-space: normal;
  word-break: break-all;
  word-wrap: break-word;
  overflow-wrap: anywhere;
}

.cg-item-hint {
  display: block;
  padding: 24rpx 8rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
  line-height: 1.7;
  word-break: break-all;
}

.cg-tip {
  margin: 20rpx 36rpx 32rpx;
  padding: 20rpx 24rpx;
  background: #f7f8fc;
  border-radius: 14rpx;
}

.cg-tip-text {
  font-size: 24rpx;
  color: #98a2b3;
  line-height: 1.7;
  word-break: break-all;
  overflow-wrap: anywhere;
}
