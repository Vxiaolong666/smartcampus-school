.cb-load-fail {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 保留顶部导航（状态栏 + 导航栏），失败时仍可正常返回 */
  top: calc(var(--status-bar-height, 0px) + 88rpx);
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: rgba(239, 241, 255, 0.97);
  animation: clf-fade-in 0.2s ease-out both;
}

.cb-load-fail__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0 40rpx;
}

.cb-load-fail__icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
  animation: clf-pop-in 0.4s cubic-bezier(0.34, 1.4, 0.64, 1) 0.04s both;
}

.cb-load-fail__title {
  font-size: 32rpx;
  font-weight: bold;
  color: #48416f;
  margin-bottom: 12rpx;
  animation: clf-rise-in 0.32s ease-out 0.1s both;
}

.cb-load-fail__desc {
  font-size: 26rpx;
  color: #948eb3;
  text-align: center;
  line-height: 1.6;
  animation: clf-rise-in 0.32s ease-out 0.16s both;
}

.cb-load-fail__btn {
  margin-top: 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 60rpx;
  background: #13c2c2;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
  font-weight: bold;
  animation: clf-rise-in 0.32s ease-out 0.22s both;
}

.cb-load-fail__btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

@keyframes clf-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes clf-pop-in {
  from {
    opacity: 0;
    transform: scale(0.8) translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes clf-rise-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
