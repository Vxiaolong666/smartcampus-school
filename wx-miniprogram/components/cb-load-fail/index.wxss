.cb-load-fail {
  /* 只覆盖所在的内容区容器（.content-wrapper 为定位参照），不涉及导航栏 */
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  /* 横向居中即可，不做垂直居中 */
  align-items: flex-start;
  justify-content: center;
  padding: 100rpx 60rpx 0;
  /* 不透明页面底色：彻底盖住原内容 */
  background: #eff1ff;
  /* 与内容区保持一致的上圆角，避免把原有圆角/顶部背景图盖成直角 */
  border-radius: 60rpx 60rpx 0 0;
  overflow: hidden;
  /* 不做整体淡入：网络失败时要立即完全遮住内容区，避免原内容闪现 */
}

.cb-load-fail__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0 40rpx;
}

.cb-load-fail__icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
  animation: clf-pop-in 0.4s cubic-bezier(0.34, 1.4, 0.64, 1) 0.04s both;
}

.cb-load-fail__title {
  font-size: 32rpx;
  font-weight: bold;
  color: #48416f;
  margin-bottom: 12rpx;
  animation: clf-rise-in 0.32s ease-out 0.1s both;
}

.cb-load-fail__desc {
  font-size: 26rpx;
  color: #948eb3;
  text-align: center;
  line-height: 1.6;
  animation: clf-rise-in 0.32s ease-out 0.16s both;
}

.cb-load-fail__btn {
  margin-top: 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 60rpx;
  background: #13c2c2;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
  font-weight: bold;
  animation: clf-rise-in 0.32s ease-out 0.22s both;
}

.cb-load-fail__btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

@keyframes clf-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes clf-pop-in {
  from {
    opacity: 0;
    transform: scale(0.8) translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes clf-rise-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
