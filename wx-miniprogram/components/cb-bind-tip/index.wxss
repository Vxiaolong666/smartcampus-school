:host {
  display: block;
}

.cb-bind-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  animation: cbt-fade-in 0.2s ease-out both;
}

.cb-bind-tip--compact {
  padding: 40rpx 0;
}

/* 图标→标题→说明→按钮 依次入场，形成轻量的层次感 */
.cb-bind-tip__icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
  animation: cbt-pop-in 0.4s cubic-bezier(0.34, 1.4, 0.64, 1) 0.04s both;
}

.cb-bind-tip__title {
  font-size: 32rpx;
  font-weight: bold;
  color: #48416f;
  margin-bottom: 12rpx;
  animation: cbt-rise-in 0.32s ease-out 0.1s both;
}

.cb-bind-tip__desc {
  font-size: 28rpx;
  color: #948eb3;
  text-align: center;
  line-height: 1.6;
  animation: cbt-rise-in 0.32s ease-out 0.16s both;
}

.cb-bind-tip__btn {
  margin-top: 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 60rpx;
  background: #13c2c2;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  font-weight: bold;
  animation: cbt-rise-in 0.32s ease-out 0.22s both;
}

.cb-bind-tip__btn::after {
  border: none;
}

@keyframes cbt-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes cbt-pop-in {
  from {
    opacity: 0;
    transform: scale(0.8) translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes cbt-rise-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
