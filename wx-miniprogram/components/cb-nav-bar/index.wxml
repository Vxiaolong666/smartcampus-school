
<view class="nav-bar">
  <view style="height:{{statusBarHeight}}px;"></view>
  <view class="nav-bar-content {{showBack ? '' : 'no-back'}}" style="height:{{menuBarHeight}}px;">
    <view wx:if="{{showBack}}" class="nav-bar-back" bind:tap="handleBack">
      <view class="nav-bar-back-icon" style="border-color: {{backColor}};"></view>
    </view>
    <!-- 内容插槽 -->
    <slot></slot>
  </view>
</view>
